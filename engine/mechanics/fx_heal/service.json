{
  "mechanic": "fx_heal",
  "handlers": [
    {
      "on": "command.heal",
      "do": [
        {
          "op": "heal",
          "target": "$target",
          "amount": "$amount"
        },
        {
          "emit": "fx_heal.healed",
          "with": {
            "target": "$target",
            "amount": "$amount"
          }
        }
      ]
    }
  ]
}
