      ]
    }
  },
  {
    "name": "leaves other statuses on the target alone",
    "given": {
      "entities": {
        "enemy": {
          "hp": 30,
          "maxHp": 30,
          "statuses": {
            "dazed": 1
          }
        }
      }
    },
    "when": {
      "command": "status.strength.apply",
      "with": {
        "target": "enemy",
