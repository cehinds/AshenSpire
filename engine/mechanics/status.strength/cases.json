      "entities": {
        "enemy": {
          "hp": 30,
          "maxHp": 30,
          "statuses": {
            "strength": 2
          }
        }
      }
    },
    "when": {
      "command": "status.strength.apply",
      "with": {
        "stacks": 3,
        "target": "enemy"
      }
    },
    "then": {
      "entities": {
        "enemy": {
          "statuses": {
            "strength": 5
          }
        }
      },
      "events": [
        "status.strength.applied"
      ]
    }
  },
  {
    "name": "removes part of the Strength stacks",
    "given": {
      "entities": {
        "enemy": {
          "hp": 30,
          "maxHp": 30,
          "statuses": {
            "strength": 4
          }
        }
      }
    },
    "when": {
      "command": "status.strength.remove",
      "with": {
        "amount": 1,
