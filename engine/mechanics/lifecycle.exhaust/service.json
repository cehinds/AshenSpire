{
  "mechanic": "lifecycle.exhaust",
  "handlers": [
    {
      "on": "command.exhaust",
      "do": [
        {
          "op": "exhaust",
          "card": "$card"
        },
        {
          "emit": "lifecycle.exhaust.exhausted",
          "with": {
            "card": "$card"
          }
        }
      ]
    }
  ]
}
