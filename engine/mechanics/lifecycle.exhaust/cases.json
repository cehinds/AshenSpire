[
  {
    "name": "moves the card from hand to exhaust",
    "given": {
      "entities": {
        "self": {
          "piles": {
            "hand": [
              "strike",
              "defend"
            ],
            "exhaust": []
          }
        }
      }
    },
    "when": {
      "command": "lifecycle.exhaust.exhaust",
      "with": {
        "card": "strike"
      }
    },
    "then": {
      "entities": {
        "self": {
          "piles": {
            "hand": [
              "defend"
            ],
            "exhaust": [
              "strike"
            ]
          }
        }
      },
      "events": [
        "lifecycle.exhaust.exhausted"
      ]
    }
  },
  {
    "name": "exhausting the last card empties the hand",
