              "strike"
            ],
            "exhaust": []
          }
        }
      }
    },
    "when": {
      "command": "lifecycle.exhaust.exhaust",
      "with": {
        "card": "strike"
      }
    },
    "then": {
      "entities": {
        "self": {
          "piles": {
            "hand": [],
            "exhaust": [
              "strike"
            ]
          }
        }
      },
      "events": [
        "lifecycle.exhaust.exhausted"
      ]
    }
  },
  {
    "name": "appends to a non-empty exhaust pile",
