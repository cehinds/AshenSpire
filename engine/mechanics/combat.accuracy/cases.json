          "sweep": 2
        },
        "stanceMinimum": 1,
        "stanceMaximum": 1.5
      }
    }
  },
  {
    "name": "source-disable",
    "when": {
      "bindingQuery": {
        "attachments": [
          {
            "ownerId": "actor",
            "sourceInstanceId": "actor",
