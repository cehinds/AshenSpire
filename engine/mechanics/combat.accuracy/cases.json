        "moduleParameters": {
          "combat.accuracy": {
            "baseAC": 1,
            "evasionPerStack": 2,
            "precisionPerStack": 1,
            "maneuverPrecision": {
              "smash": 1,
              "sweep": 2
            },
            "stanceMinimum": 1,
            "stanceMaximum": 1.5
          }
        },
        "query": "parameters"
