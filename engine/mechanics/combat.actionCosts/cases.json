[
  {
    "name": "module-defaults",
    "when": {
      "bindingQuery": {
        "attachments": [
          {
            "ownerId": "actor",
            "sourceInstanceId": "actor",
            "kind": "entity",
            "tags": [
              "combat:actionCosts"
            ]
          }
        ],
        "moduleParameters": {
          "combat.actionCosts": {
            "enemyHealBlockCost": 3
          }
        },
        "query": "parameters"
      }
    },
    "then": {
      "value": {
        "enemyHealBlockCost": 3
      }
    }
  },
  {
    "name": "source-disable",
    "when": {
      "bindingQuery": {
        "attachments": [
          {
            "ownerId": "actor",
            "sourceInstanceId": "actor",
            "kind": "entity",
            "tags": [
              "combat:actionCosts"
            ],
            "mechanicBindings": [
              {
                "tag": "combat:actionCosts",
                "enabled": false
              }
            ]
          }
        ],
        "moduleParameters": {
          "combat.actionCosts": {
            "enemyHealBlockCost": 3
          }
        },
        "query": "parameters"
      }
    },
    "then": {
      "error": "one active binding"
    }
  },
  {
    "name": "invalid-param",
    "when": {
      "bindingQuery": {
        "attachments": [
          {
            "ownerId": "actor",
            "sourceInstanceId": "actor",
            "kind": "entity",
            "tags": [
              "combat:actionCosts"
            ],
            "mechanicBindings": [
              {
                "tag": "combat:actionCosts",
                "parameters": {
                  "unknown": 1
                }
              }
            ]
          }
        ],
        "moduleParameters": {
          "combat.actionCosts": {
            "enemyHealBlockCost": 3
          }
        },
        "query": "parameters"
      }
    },
    "then": {
      "error": "unknown parameter"
    }
  }
]
