            ],
            "mechanicBindings": [
              {
                "tag": "combat:perception",
                "enabled": false
              }
            ]
          }
        ],
        "moduleParameters": {
          "combat.perception": {
            "baseDC": 5,
            "levelBaseline": 1,
            "intelligenceBaseline": 0,
            "levelWeight": 1,
            "intelligenceWeight": 1
          }
        },
        "query": "parameters"
      }
    },
    "then": {
