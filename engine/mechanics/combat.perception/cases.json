[
  {
    "name": "module-defaults",
    "when": {
      "bindingQuery": {
        "attachments": [
          {
            "ownerId": "actor",
            "sourceInstanceId": "actor",
            "kind": "entity",
            "tags": [
              "combat:perception"
            ]
          }
        ],
        "moduleParameters": {
          "combat.perception": {
            "baseDC": 5,
            "levelBaseline": 1,
            "intelligenceBaseline": 0,
            "levelWeight": 1,
            "intelligenceWeight": 1
          }
        },
        "query": "parameters"
      }
