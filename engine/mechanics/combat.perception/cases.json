    "then": {
      "value": {
        "baseDC": 5,
        "levelBaseline": 1,
        "intelligenceBaseline": 0,
        "levelWeight": 1,
        "intelligenceWeight": 1
      }
    }
  },
  {
    "name": "source-disable",
    "when": {
      "bindingQuery": {
        "attachments": [
          {
            "ownerId": "actor",
            "sourceInstanceId": "actor",
            "kind": "entity",
            "tags": [
