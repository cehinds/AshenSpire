{
  "mechanic": "status.bleed",
  "handlers": [
    {
      "on": "command.apply",
      "do": [
        {
          "op": "applyStatus",
          "target": "$target",
          "status": "bleed",
          "stacks": "$stacks"
        },
        {
          "emit": "status.bleed.applied",
          "with": {
            "target": "$target",
            "stacks": "$stacks"
          }
        }
      ]
    },
    {
      "on": "command.remove",
      "do": [
        {
          "op": "removeStatus",
          "target": "$target",
          "status": "bleed",
          "amount": "$amount"
        },
        {
          "emit": "status.bleed.removed",
          "with": {
            "target": "$target",
            "amount": "$amount"
          }
        }
      ]
    }
  ]
}
