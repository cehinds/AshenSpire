{
  "$id": "ashen.mechanic@1",
  "title": "Mechanic manifest",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][A-Za-z0-9_.-]*$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "attaches": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "card",
          "character",
          "gear",
          "relic",
          "status",
          "entity",
          "combat",
          "run",
          "map",
          "none"
        ]
      }
    },
    "files": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "interface": {
          "type": "string",
          "minLength": 1
        },
        "service": {
          "type": "string",
          "minLength": 1
        },
        "cases": {
          "type": "string",
          "minLength": 1
        },
        "guide": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "model",
        "interface",
        "service"
      ],
      "additionalProperties": false
    },
    "presentation": {
      "type": "object",
      "properties": {
        "icon": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "color": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "portability": {
      "enum": [
        "portable",
        "legacy",
        "data"
      ]
    },
    "legacy": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "file"
      ],
      "additionalProperties": false
    },
    "settings": {
      "type": "object"
    },
    "authored": {
      "type": "boolean",
      "description": "true when the folder is hand-authored; tools/mechanics-generate.mjs never rewrites it."
    }
  },
  "required": [
    "id",
    "tag",
    "version",
    "family",
    "label",
    "attaches",
    "files",
    "portability"
  ],
  "additionalProperties": false
}
