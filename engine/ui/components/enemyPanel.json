{
  "id": "enemyPanel",
  "description": "An enemy on the battlefield: name, health, poise, intent and statuses. Reads src/ui/components/combatantFrame.js, combatantOverhead.js, src/ui/models/CombatantStackModel.js and TargetLayerModel.js. SP, MP and card costs are not shown here; the inspector gates them.",
  "layout": {
    "ref": "content/config/ui/scenes/w4a-combat.json",
    "path": "components.combatantStack"
  },
  "viewModel": {
    "props": {
      "entity": "entityRef",
      "lane": "string"
    },
    "bindings": {
      "name": "$entity.name",
      "hp": "$entity.pools.hp",
      "poise": "$entity.pools.poise",
      "defense": "$entity.defense",
      "intent": "intent.of($entity)",
      "statuses": "$entity.statuses",
      "sprite": "$entity.sprite"
    },
    "visibility": {
      "query": "enemy_visibility.visibleFields",
      "appliesTo": "enemy",
      "fields": {
        "hp": "hp",
        "poise": "poise",
        "defense": "defense",
        "intent": "intent",
        "statuses": "statuses"
      }
    }
  },
  "states": [
    "idle",
    "candidate",
    "targeted",
    "acting",
    "staggered",
    "defeated"
  ],
  "events": {
    "tap": "combat.selectTarget",
    "hold": "inspect.open"
  },
  "children": [
    {
      "component": "meter",
      "slot": "hp",
      "props": {
        "kind": "hp"
      }
    },
    {
      "component": "meter",
      "slot": "poise",
      "props": {
        "kind": "poise"
      }
    },
    {
      "component": "intent",
      "slot": "intent"
    },
    {
      "component": "statusTray",
      "slot": "statuses"
    }
  ],
  "assets": [
    "enemy.sprite"
  ],
  "platforms": [
    "mobile",
    "tablet",
    "desktop"
  ]
}
