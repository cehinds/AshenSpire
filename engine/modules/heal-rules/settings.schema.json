{
  "type": "object",
  "properties": {
    "mode": {
      "enum": [
        "legacy",
        "configured"
      ]
    },
    "match": {
      "enum": [
        "mostSpecific",
        "first"
      ]
    },
    "authoredCostWins": {
      "type": "boolean"
    },
    "shapes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cost": {
            "type": "object",
            "properties": {
              "sp": {
                "type": "integer",
                "minimum": 0,
                "maximum": 99
              },
              "mp": {
                "type": "integer",
                "minimum": 0,
                "maximum": 99
              }
            },
            "required": [
              "sp",
              "mp"
            ],
            "additionalProperties": false
          },
          "amount": {
            "type": "object",
            "properties": {
              "percentMaxHp": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "percentMaxHp"
            ],
            "additionalProperties": false
          },
          "exhaust": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "tags",
          "cost",
          "amount",
          "exhaust"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "mode",
    "match",
    "authoredCostWins",
    "shapes"
  ],
  "additionalProperties": false
}
