{
  "type": "object",
  "properties": {
    "mode": {
      "enum": [
        "legacy",
        "configured"
      ]
    },
    "servicesPerVisit": {
      "enum": [
        1,
        "all"
      ],
      "description": "1: exactly one listed service closes the visit. \"all\": every listed service is usable once in the same visit and none closes another."
    },
    "services": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "rest",
          "strategize",
          "smith",
          "levelUp",
          "upgradeCard"
        ]
      },
      "minItems": 1
    },
    "allowEmptyStrategize": {
      "enum": [
        true
      ]
    },
    "recovery": {
      "type": "object",
      "properties": {
        "hp": {
          "anyOf": [
            { "enum": ["full"] },
            { "type": "number", "minimum": 0.01, "maximum": 1 }
          ],
          "description": "\"full\", or a fraction of max HP in (0, 1] restored by the rest service (0.01 is the smallest accepted)."
        },
        "sp": {
          "enum": [
            "full"
          ]
        },
        "mp": {
          "enum": [
            "full"
          ]
        },
        "healingFlasks": {
          "enum": [
            "full"
          ]
        },
        "mpFlasks": {
          "enum": [
            "full"
          ]
        }
      },
      "required": [
        "hp",
        "sp",
        "mp",
        "healingFlasks",
        "mpFlasks"
      ],
      "additionalProperties": false
    },
    "smith": {
      "type": "object",
      "properties": {
        "free": {
          "type": "boolean"
        },
        "tiersPerService": {
          "type": "integer",
          "enum": [
            1
          ]
        }
      },
      "required": [
        "free",
        "tiersPerService"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "mode",
    "servicesPerVisit",
    "services",
    "recovery",
    "smith"
  ],
  "additionalProperties": false
}
