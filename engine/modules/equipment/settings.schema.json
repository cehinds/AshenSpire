{
  "type": "object",
  "properties": {
    "mode": {
      "enum": [
        "legacy",
        "configured"
      ]
    },
    "editorEnabled": {
      "type": "boolean"
    },
    "editorWhere": {
      "type": "string",
      "minLength": 1
    },
    "weaponArts": {
      "type": "boolean",
      "description": "Core weapon arts (owner 2026-11-01): a worn weapon lends its default weapon-art card(s) to the deck as item-owned cards. Absent or false: off. Kits and the Dodge Roll are not controlled by this flag and stay off in configured profiles."
    },
    "fixedAppearance": {
      "type": "boolean"
    },
    "requirementsPolicy": {
      "enum": [
        "none",
        "legacy"
      ]
    },
    "upgradeBonuses": {
      "type": "object",
      "properties": {
        "weaponARPerTier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "armorDRPerTier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "tierBonusSteps": {
          "type": "array",
          "description": "Optional Core Smith ladder: the bonus each tier adds (Core: [1,1,2] = +1, +1, +2). Its length is the top tier; the item's effective bonus is the sum of the steps taken. Absent: the authored CSV ladder and one bonus per tier.",
          "items": { "type": "integer", "minimum": 0, "maximum": 1000 },
          "minItems": 1,
          "maxItems": 10
        },
        "tierStoneCosts": {
          "type": "array",
          "description": "Smithing Stones to promote to each tier of tierBonusSteps (same length).",
          "items": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "minItems": 1,
          "maxItems": 10
        }
      },
      "required": [
        "weaponARPerTier",
        "armorDRPerTier"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "mode",
    "editorEnabled",
    "editorWhere",
    "fixedAppearance",
    "requirementsPolicy",
    "upgradeBonuses"
  ],
  "additionalProperties": false
}
