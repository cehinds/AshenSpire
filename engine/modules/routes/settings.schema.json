{
  "type": "object",
  "properties": {
    "mode": {
      "enum": [
        "legacy",
        "configured"
      ]
    },
    "acts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "prebossNodes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "description": "Number of pre-boss depths visited on a path; branching alternatives do not add levels."
    },
    "restsPerAct": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Number of mandatory rest depths; each rest depth has one visible node shared by every path."
    },
    "hideUnknownNodes": {
      "type": "boolean"
    },
    "restFloors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000
      }
    },
    "branchColumns": {
      "type": "integer",
      "minimum": 2,
      "maximum": 5,
      "description": "Number of lanes at non-rest depths. Rest and boss nodes merge the lanes."
    }
  },
  "required": [
    "mode",
    "acts",
    "prebossNodes",
    "restsPerAct",
    "hideUnknownNodes",
    "restFloors",
    "branchColumns"
  ],
  "additionalProperties": false
}
