{
  "type": "object",
  "properties": {
    "mode": {
      "enum": [
        "legacy",
        "configured"
      ]
    },
    "extraRow": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "sides": {
          "type": "array",
          "items": {
            "enum": [
              "enemy"
            ]
          },
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true
        },
        "capacityPerLane": {
          "enum": [
            1
          ]
        }
      },
      "required": [
        "enabled",
        "sides",
        "capacityPerLane"
      ],
      "additionalProperties": false
    },
    "gridOption": {
      "type": "boolean",
      "description": "The combat Grid checkbox and the formation-grid overlay. false: no Grid checkbox in combat and the overlay stays off, even when a saved preference says on (the preference is kept). Absent or true is on."
    }
  },
  "required": [
    "mode",
    "extraRow"
  ],
  "additionalProperties": false
