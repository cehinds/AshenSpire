{
  "type": "object",
  "properties": {
    "mode": {
      "enum": [
        "legacy",
        "configured"
      ]
    },
    "rounding": {
      "enum": [
        "down",
        "nearest",
        "up"
      ]
    },
    "levelFrom": {
      "enum": [
        "levelProfile.min",
        "levelProfile.max",
        "encounter"
      ]
    },
    "statRules": {
      "type": "object",
      "properties": {
        "hp": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          }
        },
        "sp": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          }
        },
        "mp": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          }
        },
        "hand": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          }
        }
      },
      "required": [
        "hp",
        "sp",
        "mp",
        "hand"
      ],
      "additionalProperties": false
    },
    "enemyStartingBudget": {
      "type": "integer",
      "minimum": 0,
      "maximum": 200,
      "description": "A level-1 enemy's attribute budget, before attributePointsPerLevel per level (owner 2026-11-28: 6, apart from the player's 1). Absent: the player's starting budget."
    },
    "attributeFill": {
      "type": "object",
      "properties": {
        "defaultPriority": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "enum": [
              "strength",
              "dexterity",
              "constitution",
              "wisdom",
              "intelligence"
            ]
          }
        },
        "priorityWeights": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "floor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99,
          "description": "Every enemy attribute starts at this value (owner, 2026-11-07: 1) before the remaining budget is filled by priority. Variance never moves a stat below max(floor, authored)."
        },
        "caps": {
          "type": "object",
          "properties": {
            "strength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            },
            "dexterity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            },
            "constitution": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            },
            "wisdom": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            },
            "intelligence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "defaultPriority",
        "priorityWeights",
        "caps"
      ],
      "additionalProperties": false
    },
    "enemyLevelScaling": {
      "type": "object",
      "description": "Optional (owner, 2026-11-20). An enemy's fight level from act, tier and floor step: step = floor((floor - 1) / floorsPerStep), at most the last table entry; a boss uses bossSteps. Each step adds hpPerStep HP (not bosses) and gearPerStep AR/DR; spCap caps a tier's SP after gear and relics; attributeCaps caps a tier's own attributes. Absent: the level stays levelFrom's bound.",
      "properties": {
        "floorsPerStep": { "type": "integer", "minimum": 1, "maximum": 99 },
        "levels": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "minion": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "integer", "minimum": 1, "maximum": 99 } },
              "elite": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "integer", "minimum": 1, "maximum": 99 } },
              "boss": { "type": "integer", "minimum": 1, "maximum": 99 }
            },
            "required": ["minion", "elite", "boss"],
            "additionalProperties": false
          }
        },
        "hpPerStep": { "type": "number", "minimum": 0, "maximum": 10 },
        "gearPerStep": {
          "type": "object",
          "properties": {
            "ar": { "type": "integer", "minimum": 0, "maximum": 99 },
            "dr": { "type": "integer", "minimum": 0, "maximum": 99 }
          },
          "additionalProperties": false
        },
        "bossSteps": { "type": "integer", "minimum": 0, "maximum": 10 },
        "spCap": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 99 }
        },
        "attributeCaps": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "strength": { "type": "integer", "minimum": 0, "maximum": 99 },
              "dexterity": { "type": "integer", "minimum": 0, "maximum": 99 },
              "constitution": { "type": "integer", "minimum": 0, "maximum": 99 },
              "wisdom": { "type": "integer", "minimum": 0, "maximum": 99 },
              "intelligence": { "type": "integer", "minimum": 0, "maximum": 99 }
            },
            "additionalProperties": false
          }
        }
      },
      "required": ["floorsPerStep", "levels", "hpPerStep", "gearPerStep", "bossSteps", "spCap", "attributeCaps"],
      "additionalProperties": false
    },
    "attributeOffset": {
      "type": "object",
      "description": "Optional (no default since 2026-11-07). Added to each enemy attribute after gear and relic bonuses, floored at 0. The budget check ignores it.",
      "properties": {
        "strength": { "type": "integer", "minimum": -20, "maximum": 20 },
        "dexterity": { "type": "integer", "minimum": -20, "maximum": 20 },
        "constitution": { "type": "integer", "minimum": -20, "maximum": 20 },
        "wisdom": { "type": "integer", "minimum": -20, "maximum": 20 },
        "intelligence": { "type": "integer", "minimum": -20, "maximum": 20 }
      },
      "additionalProperties": false
    },
    "penaltyFloor": {
      "type": "object",
      "properties": {
        "sp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "mp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "hp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        }
      },
      "required": [
        "sp",
        "mp",
        "hp"
      ],
      "additionalProperties": false
    },
    "tagRules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "requires": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "variance": {
            "type": "boolean"
          },
          "pools": {
            "type": "object",
            "properties": {
              "hp": {
                "type": "integer",
                "minimum": -1000,
                "maximum": 100000
              },
              "sp": {
                "type": "integer",
                "minimum": -99,
                "maximum": 99
              },
              "mp": {
                "type": "integer",
                "minimum": -99,
                "maximum": 99
              }
            },
            "additionalProperties": false
          },
          "hand": {
            "type": "integer",
            "minimum": -20,
            "maximum": 20
          },
          "attributeFloor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99,
            "description": "The lowest own attribute a character with this tag starts at; replaces attributeFill.floor (Core players: 0, owner 2026-11-28)."
          },
          "attributeBudget": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200
            }
          },
          "deckSize": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99
            }
          },
          "spRange": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            }
          },
          "deckDefault": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "mode",
    "rounding",
    "levelFrom",
    "statRules",
    "attributeFill",
    "penaltyFloor",
    "tagRules"
  ],
  "additionalProperties": false
}
