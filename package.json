{
  "name": "ashenspire",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node tools/launch.mjs",
    "build": "node tools/launch.mjs --build-only",
    "serve": "node tools/serve.mjs --no-open",
    "test": "node tests/run-node.mjs --no-selftests --no-discovered",
    "test:all": "node tests/run-node.mjs",
    "validate:ui": "node tools/ui-validate.mjs --check",
    "validate:maps": "node tools/maps-validate.mjs --check",
    "validate:config": "node tools/config-build.mjs --check",
    "build:game": "node tools/build-game.mjs --check",
    "plantsites": "node tools/plantsites.mjs --check",
    "art:fetch": "node tools/fetch-art.mjs --pack light,common",
    "receipts": "node tools/receipts.mjs --check"
  }
}
