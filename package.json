{
  "name": "ashenspire",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "start": "node tools/launch.mjs",
    "build:standalone": "node tools/launch.mjs --build-only",
    "serve": "node tools/serve.mjs --no-open",
    "dev": "node tools/serve.mjs --watch",
    "studio": "node tools/score-studio/launch.mjs",
    "play": "node tools/owner/play.mjs",
    "check": "node tools/owner/check.mjs",
    "ship": "node tools/owner/ship.mjs",
    "sync": "node tools/owner/sync.mjs",
    "qa:sandbox": "node tools/qa-sandbox.mjs",
    "balance:card-budget": "node tools/card-budget-report.mjs",
    "combat-power": "node tools/combat-power-report.mjs",
    "combat-power:check": "node tools/combat-power-report.mjs --check",
    "cards:generate": "node tools/generate-cards.mjs",
    "cards:import-subclasses": "node tools/import-subclass-catalog.mjs",
    "level-lists": "node tools/level-lists.mjs",
    "level-lists:check": "node tools/level-lists.mjs --check",
    "qa:redraw-probe": "node tools/redraw-probe.mjs",
    "qa:combat-canvas": "node tools/combat-canvas-qa.mjs",
    "probe:enemy-turn": "node tools/verdict.mjs -- node tools/enemy-turn-probe.mjs",
    "probe:text-size": "node tools/verdict.mjs -- node tools/text-size-probe.mjs",
    "test": "node tests/run-node.mjs --no-selftests --no-discovered",
    "test:all": "node tests/run-node.mjs",
    "test:pr": "node tools/verdict.mjs -- node tests/run-node.mjs --no-selftests --no-discovered && node tools/verdict.mjs -- node tests/run-node.mjs --discovered-only --no-slow",
    "test:fixcore": "node --test tests/fixcore-*.test.mjs",
    "test:fixcore:ui": "node tests/fixcore-combat-ui.browser.mjs",
    "validate:ui": "node tools/ui-validate.mjs --check",
    "validate:maps": "node tools/maps-validate.mjs --check",
    "validate:config": "node tools/config-build.mjs --check",
    "build:game": "node tools/build-game.mjs --check",
    "plantsites": "node tools/plantsites.mjs --check",
    "tokens:css": "node tools/tokens-css.mjs --write",
    "lint:style": "node tools/style-lint.mjs --check",
    "code:check": "npm --prefix tools/code-quality run check",
    "code:format": "npm --prefix tools/code-quality run format",
    "format:changed": "node tools/code-quality/format-changed.mjs --write",
    "format:changed:check": "node tools/code-quality/format-changed.mjs --check",
    "art:fetch": "node tools/fetch-art.mjs --pack light,common",
    "receipts": "node tools/receipts.mjs --check"
  }
}
