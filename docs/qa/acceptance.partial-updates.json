      "success": [
        { "kind": "text", "label": "The purse shows the price paid (2000 -> 1897 cinders)", "selector": ".blacksmith-workspace .modal-head-status", "includes": "1897 cinders" },
        { "kind": "text", "label": "The HUD cinders follow the purchase", "selector": ".shared-hud [data-ui-component=\"cinders-counter\"]", "includes": "1897" },
        { "kind": "visible", "label": "The what-changed receipt opens over the updated screen", "selector": ".what-changed-modal" },
        { "kind": "count", "label": "The Armaments tab stays selected", "selector": "#shop-cat-armaments[aria-selected=\"true\"]", "eq": 1 },
        { "kind": "count", "label": "One Blacksmith workspace and one HUD band", "selector": ".shared-hud", "eq": 1 },
        { "kind": "consoleErrors", "label": "No console errors (shrine.ogg 404 is known on dev)", "max": 0, "ignore": ["navigator\\.vibrate", "status of 404"] }
      ],
      "failure": [
        { "kind": "text", "label": "The purse still shows 2000 cinders", "selector": ".blacksmith-workspace .modal-head-status", "includes": "2000 cinders" },
        { "kind": "count", "label": "Two Blacksmith workspaces", "selector": ".blacksmith-workspace", "min": 2 }
      ]
    },
