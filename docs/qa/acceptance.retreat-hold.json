  "request": "Retreat hold (owner ruling 2026-11-18, section 12): an enemy sent back by Retreat or a push stays in the back row through its next turn. After that the normal 'empty front row pulls the back row forward' rule applies.",
  "viewports": [
    { "name": "desktop", "width": 1280, "height": 800 },
    { "name": "phone", "width": 390, "height": 844 }
