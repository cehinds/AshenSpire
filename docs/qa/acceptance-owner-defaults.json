        },
        {
          "kind": "consoleErrors",
          "label": "No console errors",
          "max": 0
        }
      ],
      "failure": [
        {
          "kind": "style",
          "label": "Clicking the artwork does nothing (old default)",
          "selector": ".prologue-stage",
          "prop": "cursor",
