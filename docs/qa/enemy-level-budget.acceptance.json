{
  "request": "Keep going with the enemy levels and browser validation",
  "viewports": [
    {
      "name": "desktop",
      "width": 1280,
      "height": 800
    },
    {
      "name": "phone",
      "width": 390,
      "height": 844
    }
  ],
  "scenes": [
    {
      "name": "level-one",
      "url": "?shot=combat&gameProfile=core&shotSeed=4&shotEnemies=wanderingSoldier&shotHand=5",
      "ready": ".combatant.enemy .sprite",
      "settleMs": 1200,
      "actions": [
        {
          "hold": {
            "selector": ".combatant.enemy .sprite",
            "ms": 800
          }
        }
      ],
      "success": [
        {
          "kind": "visible",
          "label": "Inspector opens",
          "selector": ".combatant-door"
        },
        {
          "kind": "text",
          "label": "Correct level",
          "selector": ".combatant-door",
          "matches": "Level 1"
        },
        {
          "kind": "text",
          "label": "Own/gear key is present",
          "selector": "[data-fact=\"attributes\"] .r-label",
          "includes": "Attributes (own+gear)"
        },
        {
          "kind": "style",
          "label": "Attribute label wraps",
          "selector": "[data-fact=\"attributes\"] .r-label",
          "prop": "white-space",
          "equals": "normal"
        },
        {
          "kind": "noOverlap",
          "label": "Attribute label and value do not overlap",
          "a": "[data-fact=\"attributes\"] .r-label",
          "b": "[data-fact=\"attributes\"] .as-status"
        },
        {
          "kind": "within",
          "label": "Inspector fits viewport",
          "selector": ".combatant-door",
          "container": "body"
        },
        {
          "kind": "consoleErrors",
          "label": "No application errors",
          "max": 0,
          "ignore": [
            "^Blocked call to navigator\\.vibrate"
          ]
        }
      ],
      "failure": []
    },
