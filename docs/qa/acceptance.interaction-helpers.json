{
  "request": "Shared interaction helpers (MarkSelected, ActivateOnKey, RovingList, ArmLongPress) replace per-screen selected-state, Enter/Space, arrow-key, long-press and double-press code in settings, the Blacksmith, the flask menu, the reward screen and door, the customize/creation rails, bestiary, compendium, the deck editor, the combat combatant long-press (600 ms) and the armament radial hold (360 ms). No visual change is intended, except ARIA attributes.",
  "viewports": [
    {
      "name": "desktop",
      "width": 1280,
      "height": 800
    },
    {
      "name": "phone",
      "width": 390,
      "height": 844
    }
  ],
  "scenes": [
    {
      "name": "settings-section-tab",
      "url": "?shot=settings",
      "ready": ".set-tab",
      "settleMs": 2000,
      "actions": [
        {
          "click": ".set-tab[data-member=\"General\"]"
        },
        {
          "wait": {
            "ms": 600
          }
        }
      ],
      "success": [
        {
          "kind": "count",
          "label": "The clicked General tab is aria-selected=\"true\"",
          "selector": ".set-tab[data-member=\"General\"][aria-selected=\"true\"]",
          "eq": 1
        },
        {
          "kind": "count",
          "label": "Exactly one section tab is selected",
          "selector": ".set-tab[aria-selected=\"true\"]",
          "eq": 1
        },
        {
          "kind": "count",
          "label": "The other two section tabs are aria-selected=\"false\"",
          "selector": ".set-tab[aria-selected=\"false\"]",
          "eq": 2
        },
        {
          "kind": "count",
          "label": "The General tab carries the on class and aria-current",
          "selector": ".set-tab.on[aria-current=\"true\"][data-member=\"General\"]",
          "eq": 1
        },
        {
          "kind": "consoleErrors",
          "label": "No console errors",
          "max": 0,
          "ignore": [
            "navigator\\.vibrate"
          ]
        }
      ],
      "failure": [
        {
          "kind": "count",
          "label": "Advanced is still marked selected",
          "selector": ".set-tab[data-member=\"Advanced\"][aria-selected=\"true\"]",
          "min": 1
