        {
          "kind": "count",
          "label": "A deselected section tab still carries aria-current",
          "selector": ".set-tab:not([data-member=\"General\"])[aria-current]",
          "min": 1
        },
        {
          "kind": "count",
          "label": "A section tab carries aria-pressed",
          "selector": ".set-tab[aria-pressed]",
          "min": 1
        }
      ]
