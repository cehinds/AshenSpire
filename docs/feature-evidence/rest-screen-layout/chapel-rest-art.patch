diff --git a/tests/art-resolution-policy.test.mjs b/tests/art-resolution-policy.test.mjs
index 71d4341..b8d3751 100644
--- a/tests/art-resolution-policy.test.mjs
+++ b/tests/art-resolution-policy.test.mjs
@@ -25,3 +25,24 @@ test('sprites stay at 256px with cheaper encoding, while cards retain their inde
   assert.equal(policyFor('cards/extended/card-strike-1024.webp').maxEdge,720);
   assert.equal(policyFor('cards/extended/card-strike-1024.webp').quality,44);
 });
+
+
+test('chapel rest preserves full-scene detail within 720p without changing other scenery', () => {
+  const p = policyFor('player-polish/scenes/chapel-rest-desktop.webp');
+  assert.deepEqual(twinDimensions({ width: 1672, height: 941 }, p), { width: 1279, height: 720 });
+  assert.deepEqual(twinDimensions({ width: 600, height: 400 }, p), { width: 600, height: 400 });
+  assert.equal(p.quality, 78);
+  assert.equal(p.alphaQuality, 80);
+  assert.equal(policyFor('player-polish/scenes/other.webp').maxEdge, 256);
+});
+
+
+test('ultrawide chapel adds side scenery at the same 720p height', () => {
+  const p = policyFor('player-polish/scenes/chapel-rest-ultrawide.webp');
+  assert.deepEqual(twinDimensions({ width: 1938, height: 812 }, p), { width: 1718, height: 720 });
+  assert.deepEqual(twinDimensions({ width: 600, height: 250 }, p), { width: 600, height: 250 });
+  assert.equal(p.quality, 78);
+  assert.equal(p.alphaQuality, 80);
+  assert.equal(policyFor('player-polish/scenes/chapel-rest-desktop.webp').maxEdge, 1280);
+  assert.equal(policyFor('player-polish/scenes/other.webp').maxEdge, 256);
+});
diff --git a/tools/mobileart-policy.mjs b/tools/mobileart-policy.mjs
index 2522074..a5b2b67 100644
--- a/tools/mobileart-policy.mjs
+++ b/tools/mobileart-policy.mjs
@@ -46,6 +46,10 @@ export const POLICY = Object.freeze({
   alphaQuality: 50,
   // First match wins.
   overrides: Object.freeze([
+    // Extra side scenery keeps the ultrawide chapel at the same 720px height.
+    Object.freeze({ prefixes: Object.freeze(['player-polish/scenes/chapel-rest-ultrawide.webp']), maxEdge: 1720, maxHeight: 720, quality: 78, alphaQuality: 80 }),
+    // The chapel rest composition needs a readable full-scene painting.
+    Object.freeze({ prefixes: Object.freeze(['player-polish/scenes/chapel-rest-desktop.webp']), maxEdge: 1280, maxHeight: 720, quality: 78, alphaQuality: 80 }),
     Object.freeze({ prefixes: Object.freeze(['ashen-crown', 'cinder-reach', 'drowned-coast', 'hollow-weald', 'pale-marches'].map(id => `environments/${id}-combat.webp`)), maxEdge: 256, maxHeight: 256, quality: 78, alphaQuality: 80 }),
     Object.freeze({ prefixes: Object.freeze(['bg/', 'environments/', 'prologue/', 'player-polish/scenes/']), maxEdge: 256, maxHeight: 256, quality: 78, alphaQuality: 80 }),
     // Full portrait cards retain 720px resolution; a small compression change
