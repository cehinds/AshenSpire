{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cehinds/AshenSpire/blob/dev/docs/governance/continuity.schema.json",
  "title": "AshenSpire repository continuity packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "formatVersion",
    "updatedAt",
    "repository",
    "authority",
    "budgets",
    "generatedArtifacts",
    "bootstrap",
    "lanes",
    "collisions",
    "nextActions",
    "tombstones"
  ],
  "properties": {
    "$schema": { "const": "./continuity.schema.json" },
    "formatVersion": { "const": "1.0.0" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "repository": { "$ref": "#/$defs/repository" },
    "authority": { "$ref": "#/$defs/authority" },
    "budgets": { "$ref": "#/$defs/budgets" },
    "generatedArtifacts": { "$ref": "#/$defs/generatedArtifacts" },
    "bootstrap": { "$ref": "#/$defs/bootstrap" },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/lane" }
    },
    "collisions": {
      "type": "array",
      "maxItems": 24,
      "items": { "$ref": "#/$defs/collision" }
    },
    "nextActions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/action" }
    },
    "tombstones": {
      "type": "array",
      "maxItems": 24,
      "items": { "$ref": "#/$defs/tombstone" }
    },
    "forensicEvidence": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/forensicEvidence" }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "blob": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "remote", "defaultBranch", "baseSha", "observedAt", "governance", "branches"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "remote": { "$ref": "#/$defs/nonEmpty" },
        "defaultBranch": { "$ref": "#/$defs/nonEmpty" },
        "baseSha": { "$ref": "#/$defs/sha" },
        "observedAt": { "type": "string", "format": "date-time" },
        "governance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "blob"],
            "properties": {
              "path": { "type": "string", "pattern": "^(docs/|README\\.md)" },
              "blob": { "$ref": "#/$defs/blob" }
            }
          }
        },
        "branches": {
          "type": "array",
          "minItems": 4,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/branch" }
        }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "sha", "policyProtected", "githubProtectionObserved", "currentness"],
      "properties": {
        "name": { "enum": ["dev", "test", "release", "main"] },
        "role": { "enum": ["integration", "playtest", "release-staging", "stable"] },
        "sha": { "$ref": "#/$defs/sha" },
        "policyProtected": { "type": "boolean" },
        "githubProtectionObserved": { "type": "boolean" },
        "currentness": { "const": "must-match-remote" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technicalRelay", "releaseOwner", "workflowTruth", "directDevMutationAllowed", "remoteActionsRequireSeparateAuthority"],
      "properties": {
        "technicalRelay": { "const": "IT Manager III, Integration & Delivery" },
        "releaseOwner": { "const": "Constantine" },
        "workflowTruth": { "const": "GitHub Project #4 Status" },
        "directDevMutationAllowed": { "const": false },
        "remoteActionsRequireSeparateAuthority": { "const": true }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxBytes", "maxEstimatedTokens", "maxSnapshotAgeHours", "maxLanes", "maxNextActions", "maxTombstones"],
      "properties": {
        "maxBytes": { "type": "integer", "minimum": 4096, "maximum": 65536 },
        "maxEstimatedTokens": { "type": "integer", "minimum": 1024, "maximum": 16384 },
        "maxSnapshotAgeHours": { "type": "integer", "minimum": 1, "maximum": 168 },
        "maxLanes": { "type": "integer", "minimum": 1, "maximum": 24 },
        "maxNextActions": { "type": "integer", "minimum": 1, "maximum": 12 },
        "maxTombstones": { "type": "integer", "minimum": 0, "maximum": 24 }
      }
    },
    "generatedArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "owner", "command", "order", "verification", "directEditsAllowed"],
      "properties": {
        "status": { "enum": ["idle", "reserved", "running", "frozen"] },
        "owner": { "$ref": "#/$defs/nonEmpty" },
        "command": { "const": "node tools/launch.mjs --build-only" },
        "order": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "enum": ["build/AshenSpire.html", "dist/AshenSpire.html", "AshenSpire.html", "buildordinal.json"] }
        },
        "verification": { "$ref": "#/$defs/stringList" },
        "directEditsAllowed": { "const": false }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clone", "setup", "build", "tests", "pages", "recovery"],
      "properties": {
        "clone": { "$ref": "#/$defs/stringList" },
        "setup": { "$ref": "#/$defs/stringList" },
        "build": { "$ref": "#/$defs/stringList" },
        "tests": { "$ref": "#/$defs/stringList" },
        "pages": {
          "type": "object",
          "additionalProperties": false,
          "required": ["developmentUrl", "observedSource", "proofRequired", "releaseFact"],
          "properties": {
            "developmentUrl": { "type": "string", "pattern": "^https://" },
            "observedSource": { "$ref": "#/$defs/nonEmpty" },
            "proofRequired": { "$ref": "#/$defs/stringList" },
            "releaseFact": { "const": false }
          }
        },
        "recovery": { "$ref": "#/$defs/stringList" }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "acknowledged", "acknowledgedAt"],
      "properties": {
        "role": { "$ref": "#/$defs/nonEmpty" },
        "acknowledged": { "type": "boolean" },
        "acknowledgedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "verificationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "counts", "result"],
      "properties": {
        "command": { "$ref": "#/$defs/nonEmpty" },
        "counts": { "$ref": "#/$defs/nonEmpty" },
        "result": { "enum": ["PASS", "FAIL", "UNKNOWN"] }
      }
    },
    "laneVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observedAt", "result", "checks", "boundary"],
      "properties": {
        "observedAt": { "type": "string", "format": "date-time" },
        "result": { "enum": ["LOCAL_GATES_PASS_EXTERNAL_QA_PENDING", "SOURCE_FROZEN_GENERATION_PENDING", "FAIL", "UNKNOWN"] },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/verificationCheck" }
        },
        "boundary": { "$ref": "#/$defs/stringList" }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "branch", "status", "baseSha", "headSha", "availability", "owner", "claimedPaths", "dependencies", "block", "next", "rollback"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "branch": { "type": "string", "pattern": "^codex/migration-[a-z0-9-]+$" },
        "status": { "enum": ["queued", "active", "waiting-decision", "blocked", "candidate-frozen", "complete", "tombstoned"] },
        "baseSha": { "$ref": "#/$defs/sha" },
        "headSha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "availability": { "enum": ["local-only", "origin-branch", "integrated"] },
        "owner": { "$ref": "#/$defs/owner" },
        "verification": { "$ref": "#/$defs/laneVerification" },
        "claimedPaths": { "$ref": "#/$defs/stringList" },
        "dependencies": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        },
        "block": { "type": ["string", "null"] },
        "next": { "$ref": "#/$defs/nonEmpty" },
        "rollback": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "collision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "lanes", "resolution", "owner"],
      "properties": {
        "resource": { "$ref": "#/$defs/nonEmpty" },
        "lanes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        },
        "resolution": { "$ref": "#/$defs/nonEmpty" },
        "owner": { "const": "IT Manager III, Integration & Delivery" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "lane", "action", "authority"],
      "properties": {
        "order": { "type": "integer", "minimum": 1, "maximum": 99 },
        "lane": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "action": { "$ref": "#/$defs/nonEmpty" },
        "authority": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "tombstone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "closedAt", "retainUntil", "recovery", "deletionAuthorized"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "closedAt": { "type": "string", "format": "date-time" },
        "retainUntil": { "type": "string", "format": "date-time" },
        "recovery": { "$ref": "#/$defs/nonEmpty" },
        "deletionAuthorized": { "const": false }
      }
    },
    "forensicEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "uri", "sha256", "capturedAt", "canonical"],
      "properties": {
        "kind": { "enum": ["external-snapshot", "export", "receipt"] },
        "uri": { "type": "string", "pattern": "^(https://|urn:)" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "canonical": { "const": false }
      }
    }
  }
}
