  "mapItems": [
    {
      "id": "greenward-fragment",
      "name": "Greenward Map Fragment",
      "description": "Reveal a connected forest/jungle pocket.",
      "target": {
        "kind": "connected-tiles",
        "tileIds": [
          "forest-edge",
          "jungle-road",
          "sheltered-clearing"
        ]
      },
      "reveals": [
        "terrain",
        "terrain-known-props"
      ],
      "doesNotReveal": [
        "section-entered-props",
        "tile-entered-props",
        "treasure-clue-props"
      ],
      "consumePolicy": "on-new-information"
    },
    {
      "id": "greenward-road-chart",
      "name": "Greenward Road Chart",
      "description": "Trace the existing road between the two cities.",
      "target": {
        "kind": "existing-road",
        "roadId": "greenward-road"
      },
      "reveals": [
        "road-ribbon",
        "road-endpoints"
      ],
      "doesNotReveal": [
        "off-route-terrain",
        "concealed-props"
      ],
      "consumePolicy": "on-new-information"
    },
    {
      "id": "watch-treasure-sketch",
      "name": "Sketch of the Broken Watch",
      "description": "Mark an existing cache without granting its reward.",
      "target": {
        "kind": "existing-prop",
        "propId": "watch-cache"
      },
      "reveals": [
        "target-marker"
      ],
      "doesNotReveal": [
        "surrounding-terrain",
        "encounters",
        "reward-contents"
      ],
      "consumePolicy": "on-new-information"
    }
  ],
  "rewardSuggestions": [
