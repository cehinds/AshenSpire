{
  "formatVersion": 1,
  "status": "proposal-only",
  "worldFile": "hex-art.example.json",
  "description": "Companion proposal: art assets and gameplay hooks are not implemented. No new keys are added to the existing world schema.",
  "mapLayersBottomToTop": [
    "terrain",
    "water-and-roads",
    "props-by-ground-anchor",
    "fog-and-discovery",
    "selection-and-optional-labels"
  ],
  "placement": {
    "scope": "optional-landmarks",
    "chancePerEligibleTile": 0.25,
    "maxOccupiedFractionOfEligibleTiles": 0.3,
    "maxOptionalLandmarksPerTile": 1,
    "minimumHexDistanceBetweenSamePropType": 3,
    "emptyTileIsValid": true,
    "excludeTilesWithAuthoredLandmarks": true,
    "seedDomain": "map-props-v1",
    "persistPerRun": true
  },
  "sections": [
    {
      "id": "western-road",
      "tileIds": [
        "west-city",
        "crossroads",
        "ruined-watch"
      ]
    },
    {
      "id": "forest-approach",
      "tileIds": [
        "forest-edge",
        "sheltered-clearing"
      ]
    },
    {
      "id": "jungle-road",
      "tileIds": [
        "jungle-road",
        "east-city"
      ]
    }
  ],
  "visibilityRules": {
    "terrain-known": {
      "trigger": "terrain-revealed",
      "mapItemsMayRevealMarker": true
    },
    "section-entered": {
      "trigger": "first-entry-into-owning-section",
      "mapItemsMayRevealMarker": false
    },
    "tile-entered": {
      "trigger": "first-entry-into-owning-tile",
      "mapItemsMayRevealMarker": false
    },
    "treasure-clue": {
      "trigger": "first-entry-into-owning-tile",
      "mapItemsMayRevealMarker": true,
      "mapItemRevealMode": "marker-only"
    }
  },
