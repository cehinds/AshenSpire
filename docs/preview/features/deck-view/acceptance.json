{
  "request": "when inspecting deck (editing deck in a location where I can't change cards) remove the gap at the top and halve the gap between cards and change it from edit deck to view deck. also remove the Pile pre title",
  "viewports": [
    {
      "name": "desktop",
      "width": 1280,
      "height": 800
    },
    {
      "name": "phone",
      "width": 390,
      "height": 844
    },
    {
      "name": "wide",
      "width": 1920,
      "height": 1080
    },
    {
      "name": "tablet",
      "width": 820,
      "height": 1180
    }
  ],
  "scenes": [
    {
      "name": "deck-view",
      "url": "?shot=map&shotSeed=1",
      "ready": "#open-armoury",
      "settleMs": 1000,
      "actions": [
        {
          "click": "#open-armoury"
        },
        {
          "hold": {
            "ms": 60,
            "selector": ".armoury [data-modal-tab=\"deck\"]"
          }
        },
        {
          "wait": {
            "ms": 1000
          }
        }
      ],
      "success": [
        {
          "kind": "text",
          "label": "Read-only deck is named View Deck",
          "selector": ".pile-modal h2",
          "includes": "View Deck"
        },
        {
          "kind": "visible",
          "label": "The read-only deck modal is visible",
          "selector": ".deck-view-modal"
        },
        {
          "kind": "hidden",
          "label": "Pile pretitle is absent",
          "selector": ".deck-view-modal .modal-eyebrow"
        },
        {
          "kind": "style",
          "label": "Body has no extra top padding",
          "selector": ".deck-view-modal .pile-body",
          "prop": "paddingTop",
          "equals": "0px"
        },
        {
          "kind": "style",
          "label": "Rows use half the former 64px gap",
          "selector": ".deck-view-modal .as-cardgrid",
          "prop": "rowGap",
          "equals": "32px"
        },
        {
          "kind": "count",
          "label": "The deck contains visible card faces",
          "selector": ".deck-view-modal .card",
          "min": 2
        },
        {
          "kind": "within",
          "label": "The header stays inside the modal",
          "selector": ".deck-view-modal .modal-head",
          "container": ".deck-view-modal"
        },
        {
          "kind": "noOverlap",
          "label": "Header and card grid do not overlap",
          "a": ".deck-view-modal .modal-head",
          "b": ".deck-view-modal .as-cardgrid"
        },
        {
          "kind": "consoleErrors",
          "label": "No console errors",
          "max": 0,
          "ignore": [
            "navigator\\.vibrate"
          ]
        }
      ],
      "failure": [
        {
          "kind": "text",
          "label": "Read-only deck still claims to edit",
          "selector": ".pile-modal h2",
          "includes": "Edit Deck"
        },
        {
          "kind": "visible",
          "label": "Pile pretitle still appears",
          "selector": ".deck-view-modal .modal-eyebrow"
        }
      ]
    }
  ]
}
