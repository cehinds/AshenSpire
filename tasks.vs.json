{
  "version": "0.2.1",
  "tasks": [
    {
      "taskLabel": "AshenSpire: Dev server (live reload)",
      "appliesTo": "/package.json",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": ["/d", "/c", "npm run dev"],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "AshenSpire: Play",
      "appliesTo": "/package.json",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": ["/d", "/c", "npm start"],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "AshenSpire: Serve without opening a browser",
      "appliesTo": "/package.json",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": ["/d", "/c", "npm run serve"],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "AshenSpire: Fast core tests",
      "appliesTo": "/package.json",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": ["/d", "/c", "npm test"],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "AshenSpire: Full Node test suite",
      "appliesTo": "/package.json",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": ["/d", "/c", "npm run test:all"],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "AshenSpire: Compile authored content",
      "appliesTo": "/package.json",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": ["/d", "/c", "node tools/content-build.mjs"],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "AshenSpire: Build standalone",
      "appliesTo": "/package.json",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": ["/d", "/c", "npm run build:standalone"],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "AshenSpire: Check authored content",
      "appliesTo": "/package.json",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": ["/d", "/c", "node tools/content-build.mjs --check"],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "AshenSpire: Compile presentation configuration",
      "appliesTo": "/package.json",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": ["/d", "/c", "node tools/config-build.mjs"],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "AshenSpire: Check presentation configuration",
      "appliesTo": "/package.json",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": ["/d", "/c", "npm run validate:config"],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "AshenSpire: Check named icon vocabulary",
      "appliesTo": "/package.json",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": ["/d", "/c", "node --test tests/ui-icons.test.mjs"],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "AshenSpire: Compile Core game profiles",
      "appliesTo": "/package.json",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": ["/d", "/c", "node tools/game-config.mjs build"],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "AshenSpire: Check Core game profiles",
      "appliesTo": "/package.json",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": ["/d", "/c", "node tools/game-config.mjs check"],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "AshenSpire: Build game artifact",
      "appliesTo": "/package.json",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": ["/d", "/c", "node tools/build-game.mjs"],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "AshenSpire: UI: Check screens and components",
      "appliesTo": "/package.json",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": ["/d", "/c", "npm run validate:ui"],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "AshenSpire: UI: Rebuild UI index",
      "appliesTo": "/package.json",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": ["/d", "/c", "node tools/ui-validate.mjs"],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "AshenSpire: UI: Rebuild style tokens CSS",
      "appliesTo": "/package.json",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": ["/d", "/c", "npm run tokens:css"],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "AshenSpire: UI: Rebuild HUD layout CSS",
      "appliesTo": "/package.json",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": ["/d", "/c", "node tools/hud-layout-css.mjs --write"],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "AshenSpire: UI: Lint styles",
      "appliesTo": "/package.json",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": ["/d", "/c", "npm run lint:style"],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "AshenSpire: PR: Fast checks (run before a pull request)",
      "appliesTo": "/package.json",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": ["/d", "/c", "npm run test:pr"],
      "workingDirectory": "${workspaceRoot}"
    }
  ]
}
