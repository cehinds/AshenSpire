{
  "version": "0.2.1",
  "tasks": [
    {
      "taskLabel": "AshenSpire: Play",
      "appliesTo": "/package.json",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": ["npm start"],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "AshenSpire: Serve without opening a browser",
      "appliesTo": "/package.json",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": ["npm run serve"],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "AshenSpire: Fast core tests",
      "appliesTo": "/package.json",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": ["npm test"],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "AshenSpire: Full Node test suite",
      "appliesTo": "/package.json",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": ["npm run test:all"],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "AshenSpire: Compile authored content",
      "appliesTo": "/package.json",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": ["node tools/content-build.mjs"],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "AshenSpire: Build standalone",
      "appliesTo": "/package.json",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": ["npm run build:standalone"],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "AshenSpire: Start Workbench",
      "appliesTo": "/package.json",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": ["node workbench/server.mjs"],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "AshenSpire: Editor tests",
      "appliesTo": "/package.json",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": ["npm --prefix editor test"],
      "workingDirectory": "${workspaceRoot}"
    }
  ]
}
