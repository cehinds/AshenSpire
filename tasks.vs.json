      "type": "launch",
      "command": "npm",
      "args": ["start"]
    },
    {
      "taskLabel": "AshenSpire: Serve without opening a browser",
      "appliesTo": "package.json",
      "type": "launch",
      "command": "npm",
      "args": ["run", "serve"]
    },
    {
      "taskLabel": "AshenSpire: Fast core tests",
      "appliesTo": "package.json",
      "type": "launch",
      "command": "npm",
      "args": ["test"]
