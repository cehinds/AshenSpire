    {
      "taskLabel": "AshenSpire: Full Node test suite",
      "appliesTo": "package.json",
      "type": "launch",
      "command": "npm",
      "args": ["run", "test:all"]
    },
    {
      "taskLabel": "AshenSpire: Compile authored content",
      "appliesTo": "package.json",
      "type": "launch",
      "command": "node",
      "args": ["tools/content-build.mjs"]
    },
    {
      "taskLabel": "AshenSpire: Build standalone",
      "appliesTo": "package.json",
      "type": "launch",
      "command": "npm",
      "args": ["run", "build:standalone"]
