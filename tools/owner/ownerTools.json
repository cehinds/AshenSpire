{
  "$note": "Pipeline settings for npm run play, check, ship and sync (docs/OWNER-EDITING.md). Words live in ownerText.json, change wording in ownerDiff.json.",
  "git": {
    "remote": "origin",
    "baseBranch": "dev",
    "branchPrefix": "feature/Owner",
    "repositoryUrl": "https://github.com/cehinds/AshenSpire",
    "workBranch": "owner/editing",
    "openPullLimit": 200,
    "githubProgram": "gh"
  },
  "flags": {
    "quick": "--quick",
    "dryRun": "--dry-run",
    "local": "--local",
    "full": "--full",
    "prefix": "--"
  },
  "files": {
    "backupFolder": ".owner-backup",
    "patchFile": ".owner-tools.patch",
    "worktreePrefix": "ashenspire-owner-"
  },
  "limits": {
    "maxOutputBytes": 67108864,
    "outputTailLines": 25,
    "branchTitleLimit": 40,
    "receiptSummaryLines": 2,
    "stepTimeoutMs": 180000
  },
  "editableRoots": [
    "content/source/",
    "content/config/",
    "games/ashenspire/"
  ],
  "editableExtensions": [
    ".json",
    ".csv"
  ],
  "generatedNames": [
    "game.lock.json",
    "_reference.json",
    "_reference.md"
  ],
  "neverCommit": [
    "buildordinal.json",
    ".html"
  ],
  "generatedLocations": [
    "src/content/generated/",
    "src/config/generated/",
    "src/framework/data/"
  ],
  "generatedSuffixes": [
    ".generated.js",
    ".generated.css",
    "game.lock.json",
    "_reference.json",
    "_reference.md"
  ],
  "rebuiltContentFiles": [
    "games/ashenspire/packs/core/characters.json"
  ],
  "buildSteps": [
    {
      "label": "Build enemy sheets",
      "args": [
        "tools/enemy-sheets.mjs",
        "--write"
      ]
    },
    {
      "label": "Build interface config",
      "args": [
        "tools/config-build.mjs"
      ]
    },
    {
      "label": "Build token styles",
      "args": [
        "tools/tokens-css.mjs",
        "--write"
      ]
    },
    {
      "label": "Build content tables",
      "args": [
        "tools/content-build.mjs"
      ]
    },
    {
      "label": "Build game packs",
      "args": [
        "tools/game-config.mjs",
        "build"
      ]
    }
  ],
  "checkSteps": [
    {
      "label": "Check enemy sheets",
      "args": [
        "tools/enemy-sheets.mjs",
        "--check"
      ]
    },
    {
      "label": "Check interface config",
      "args": [
        "tools/config-build.mjs",
        "--check"
      ]
    },
    {
      "label": "Check token styles",
      "args": [
        "tools/tokens-css.mjs",
        "--check"
      ]
    },
    {
      "label": "Check content tables",
      "args": [
        "tools/content-build.mjs",
        "--check"
      ]
    },
    {
      "label": "Check game packs",
      "args": [
        "tools/game-config.mjs",
        "check"
      ]
    },
    {
      "label": "Check card limits",
      "args": [
        "tools/card-limits.mjs",
        "--check"
      ]
    }
  ],
  "testSteps": [
    {
      "label": "Core tests",
      "timeoutMs": 900000,
      "args": [
        "tests/run-node.mjs",
        "--no-selftests",
        "--no-discovered"
      ]
    }
  ],
  "changelog": {
    "file": "CHANGELOG.md",
    "projectionArgs": [
      "tools/about-changelog.mjs",
      "--write"
    ],
    "generatedModule": "src/content/changelog.generated.js",
    "buildOrdinalFile": "buildordinal.json"
  },
  "play": {
    "serverArgs": [
      "tools/serve.mjs",
      "--watch",
      "--editor-write",
      "--host",
      "localhost"
    ],
    "enemySheetFolder": "games/ashenspire/packs/core/enemies",
    "rebuildDelayMs": 200,
    "enemySheetStep": "Build enemy sheets",
    "enemySheetExtension": ".json",
    "generatedSheetPrefix": "_"
  }
}
