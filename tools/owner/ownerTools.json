{
  "$note": "Settings for the owner's play, check and ship commands (docs/OWNER-EDITING.md).",
  "git": {
    "remote": "origin",
    "baseBranch": "dev",
    "branchPrefix": "feature/Owner",
    "repositoryUrl": "https://github.com/cehinds/AshenSpire"
  },
  "editableRoots": [
    "content/source/",
    "content/config/",
    "games/ashenspire/"
  ],
  "editableExtensions": [
    ".json",
    ".csv"
  ],
  "generatedNames": [
    "game.lock.json",
    "_reference.json",
    "_reference.md"
  ],
  "neverCommit": [
    "buildordinal.json",
    ".html"
  ],
  "buildSteps": [
    {
      "label": "Build enemy sheets",
      "args": [
        "tools/enemy-sheets.mjs",
        "--write"
      ]
    },
    {
      "label": "Build content tables",
      "args": [
        "tools/content-build.mjs"
      ]
    },
    {
      "label": "Build interface config",
      "args": [
        "tools/config-build.mjs"
      ]
    },
    {
      "label": "Build game packs",
      "args": [
        "tools/game-config.mjs",
        "build"
      ]
    }
  ],
  "checkSteps": [
    {
      "label": "Check enemy sheets",
      "args": [
        "tools/enemy-sheets.mjs",
        "--check"
      ]
    },
    {
      "label": "Check content tables",
      "args": [
        "tools/content-build.mjs",
        "--check"
      ]
    },
    {
      "label": "Check interface config",
      "args": [
        "tools/config-build.mjs",
        "--check"
      ]
    },
    {
      "label": "Check game packs",
      "args": [
        "tools/game-config.mjs",
        "check"
      ]
    }
  ],
  "testSteps": [
    {
      "label": "Core tests",
      "args": [
        "tests/run-node.mjs",
        "--no-selftests",
        "--no-discovered"
      ]
    }
  ],
  "changelog": {
    "file": "CHANGELOG.md",
    "projectionArgs": [
      "tools/about-changelog.mjs",
      "--write"
    ],
    "generatedModule": "src/content/changelog.generated.js",
    "buildOrdinalFile": "buildordinal.json"
  },
  "play": {
    "serverArgs": [
      "tools/serve.mjs",
      "--watch",
      "--editor-write",
      "--host",
      "localhost"
    ],
    "enemySheetFolder": "games/ashenspire/packs/core/enemies",
    "rebuildDelayMs": 200,
    "enemySheetStep": "Build enemy sheets"
  },
  "generatedLocations": [
    "src/content/generated/",
    "src/config/generated/",
    "src/framework/data/"
  ],
  "generatedSuffixes": [
    ".generated.js",
    ".generated.css",
    "game.lock.json",
    "_reference.json",
    "_reference.md"
  ]
}
