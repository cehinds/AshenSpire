# OS / editor
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Node (only used for optional tooling like `npx serve`)
node_modules/
npm-debug.log*

# Local scratch — never commit balance notes or saves from here
scratch/
*.local.*

# dist: keep the stable standalone (dist/AshenSpire.html — README.md:25 hands it
# to a player); the version-stamped copies the launcher emits are build
# artifacts. The name here MUST match what tools/launch.mjs:53 writes: this rule
# read `EldenSpire-*` after the rename, matched nothing, and one build artifact
# was committed for it. Verify with:
#   node tools/launch.mjs --build-only && git status --short dist
dist/AshenSpire-*.html
.coop-session.json
