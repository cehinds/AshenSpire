# Node (only used for optional tooling like `npx serve`)
node_modules/
npm-debug.log*

# Local scratch — never commit balance notes or saves from here
scratch/
*.local.*

# Regenerable tool output — tools/character-creation-check.mjs default OUT dir
outputs/
dist/map-detail/
dist/music/
build/music/
artifacts/combat-foundations/

# tools/component-refs.mjs writes ~21MB of component reference crops here, from
# art already in the repo. It is derived, it is regenerated by running the tool,
# and nothing reads it from version control.
build/components/

# build/web/ — the de-inlined build (tools/bundle.mjs --external-art). ~4.9 MB of
# HTML beside ~40 MB of copied art and ~12 MB of map tiles, all of it derived
# from tracked source. It is ignored for the same reason the version-stamped
# standalones are: a build output in git is a second copy of the source, and
# this one is 49 MB per build. CI rebuilds it; nobody commits it.
build/web/

# preview/ — what .github/workflows/dev-preview.yml assembles and uploads. It
# has always been created by that workflow; it is named here because the
# de-inlined build made it worth reproducing locally, and it is now ~123 MB
# (a 5 MB de-inlined build beside its art, plus the 57.6 MB standalone in
# preview/standalone/). CI builds it fresh every run; committing it would put
# a third copy of the art in git.
preview/

# standalone/ — the second half of that same workflow's output. It used to sit
# inside preview/ and is now uploaded as its own artifact, so the ~39 MB
# double-clickable file can be downloaded without the ~152 MB of preview it was
# buried in. One derived file, rebuilt every run.
standalone/

# The built standalone HTML — every copy tools/launch.mjs writes. None of it is
# committed on dev: CI builds it from source on every push and pull request and
# uploads it as a workflow artifact (.github/workflows/dev-preview.yml). Tracking
# it put ~284 MB of new Git LFS objects into every rebuild and exhausted the
# repository's LFS budget. buildordinal.json, the one derived fact a pull request
# still commits, is what the receipt and tools/buildversion.mjs --check read.
# The version-stamped copies (dist/AshenSpire-<version>.html) match the dist rule.
/AshenSpire.html
/AshenSpire-mobile.html
/build/*.html
/dist/*.html
.coop-session.json
/.vs

# Personal Claude Code settings (per-user, not committed)
.claude/settings.local.json

# Agent worktrees: throwaway checkouts of this repo created inside it so
# parallel work stays isolated. They are working copies, not content — each
# already tracks its own branch, and committing one would nest a second copy
# of the tree in the first.
.claude/worktrees/

# assembled GitHub Pages site (tools/pages-site.mjs); published by the pages-builds workflow, never committed
_site/

# Reference crops and the sampled palette for the class figures
# (tools/component-refs.mjs). Cut from the concept paintings on demand and
# passed to tools/lowpoly-blender.py; `node tools/launch.mjs --build-only`
# does not touch them, so a committed copy would go stale unnoticed.
# Regenerate with: node tools/component-refs.mjs
build/components/

# Cut frames from the painted pose sheets (tools/painted-poses.mjs), the input to
# the sprite step. The sprites it produces are committed under art/poses; these
# are the intermediate, rebuilt by the recipe in art/poses/README.md.
build/painted/

# Local combat-effect validation logs and assembled preview package.
build/effect-logs/
build/combat-effects-preview/
build/combat-effects-preview.zip

# Local combat workshop and game test-build screenshots/logs.
artifacts/combat-foundations/
artifacts/combat-test/
build/pose-studio-app/
build/pose-studio-app.zip


# UI Studio (ui-studio/) keeps its config backups here
ui-studio/.state/
ui-studio/workspace/settings.json

# High-res art fetched by tools/fetch-art.mjs (docs/ART-REPO-PLAN.md)
/.art-cache/
