# Generated player-facing artifacts are byte-identity gates. Treating them as
# text lets checkout/autocrlf and test restoration produce different build/dist
# bytes while Git reports a clean tree. Preserve the exact generated bytes.
# LFS preserves the offline HTML while allowing builds above Git's file limit.
build/AshenSpire.html filter=lfs diff=lfs merge=lfs -text
dist/AshenSpire.html filter=lfs diff=lfs merge=lfs -text
AshenSpire.html filter=lfs diff=lfs merge=lfs -text
# The mobile single file (tools/bundle.mjs --mobile): the same art shrunk under
# tools/mobileart-policy.mjs, held under 30 MB. Same three homes, same rule.
build/AshenSpire-mobile.html filter=lfs diff=lfs merge=lfs -text
dist/AshenSpire-mobile.html filter=lfs diff=lfs merge=lfs -text
AshenSpire-mobile.html filter=lfs diff=lfs merge=lfs -text
