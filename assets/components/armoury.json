{
  "schemaVersion": 1,
  "surface": "armoury",
  "source": "src/ui/screens/equipment.js",
  "components": [
    { "id": "armoury.shell", "selector": ".armoury[data-composition='character-equipment']", "role": "responsive shared shell" },
    { "id": "armoury.viewSwitcher", "selector": ".armoury-views", "role": "Character/Inventory/Hybrid presentation selector" },
    { "id": "armoury.characterPane", "selector": ".armoury-character", "role": "left character pane" },
    { "id": "armoury.spritePane", "selector": ".armoury-sprite-pane", "role": "shrink-to-fit character sprite" },
    { "id": "armoury.characterSummary", "selector": ".character-summary", "role": "name, class description, and level" },
    { "id": "armoury.combatPowerGroup", "selector": ".character-power-cards", "role": "vertical Combat Power group" },
    { "id": "armoury.combatPowerCard", "selector": ".character-power-cards .disc-face", "role": "Strike, Potency, or Defense card with responsive bonus line" },
    { "id": "armoury.attributesCard", "selector": ".character-attributes", "role": "folded attributes group" },
    { "id": "armoury.attributeCard", "selector": ".character-attributes .disc-face", "role": "one expandable attribute" },
    { "id": "armoury.relicsCard", "selector": ".character-relics", "role": "folded relic group and count" },
    { "id": "armoury.equipmentPane", "selector": ".armoury-equipment", "role": "vertical armaments pane; left in Inventory and right in Hybrid" },
    { "id": "armoury.armamentsCard", "selector": ".armoury-equipment[data-component='armoury.armamentsCard']", "role": "Armaments group with configurable outer border" },
    { "id": "armoury.armamentsHeader", "selector": ".armoury-equipment-head", "role": "Armaments group header" },
    { "id": "armoury.armamentSubcard", "selector": ".armoury-slot-card", "role": "foldable armament socket subcard" },
    { "id": "armoury.socketCard", "selector": ".armoury-equipment .equip-slot", "role": "socket card; order is data-driven" },
    { "id": "armoury.socketSet", "selector": ".armoury-equipment .es-sets", "role": "socket loadout set cells" },
    { "id": "armoury.inventoryCard", "selector": ".armoury-inventory", "role": "folded unified inventory" },
    { "id": "armoury.itemCard", "selector": ".inventory-face, .equip-chip.as-face", "role": "folded item card; expands in place" },
    { "id": "armoury.itemReveal", "selector": ".inventory-detail, .disc-reveal", "role": "item model and detail disclosure" },
    { "id": "armoury.cardsCard", "selector": ".armoury-strip", "role": "folded equipment-card panel with list/grid toggle" },
    { "id": "armoury.cardList", "selector": ".armoury-card-list", "role": "configurable vertical list or grid of equipment cards" },
    { "id": "armoury.cardRow", "selector": ".armoury-card-row", "role": "folded equipment card row with count and cost" },
    { "id": "armoury.cardDetail", "selector": ".armoury-card-row-detail", "role": "expanded card icon and detail panes" },
    { "id": "armoury.cardViewToggle", "selector": ".armoury-card-view-toggle", "role": "list/grid presentation toggle" },
    { "id": "armoury.statsTray", "selector": ".armoury-stats-tray", "role": "folded compact character stats summary" },
    { "id": "armoury.disclosure", "selector": ".disc-face, .disc-reveal", "role": "shared progressive-disclosure primitive" }
  ]
}
