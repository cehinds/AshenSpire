            { "p": "eventSourceIsOwner" },
            { "p": "skillLevelAtLeast", "skill": "focus", "level": { "balance": "exposure.siphonMasteryLevel" } }
          ]
        },
        "do": [{ "op": "restoreMana", "target": "self", "amount": { "balance": "exposure.siphonRefundMastered" } }]
