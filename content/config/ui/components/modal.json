    },
    "cardUpgrade": {
      "extends": "choice"
    },
    "compare": {
      "extends": "choice"
    },
    "statUpgrade": {
      "extends": "choice"
    },
    "optionChoice": {
      "extends": "choice",
      "size": "md",
      "footSize": "short",
      "className": "option-choice",
