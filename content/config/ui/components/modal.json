      "selection": "single",
      "idAttribute": "data-option",
      "commitLabelKey": "common.choose",
      "cancelLabelKey": "common.cancel",
      "hasCancelButton": true
    },
    "smithOptions": {
      "extends": "optionChoice",
      "className": "option-choice smith-options",
      "idAttribute": "data-smith-option",
      "rowClassName": "smith-option"
    },
    "smithKeep": {
      "extends": "optionChoice",
      "className": "option-choice smith-options smith-keep",
      "idAttribute": "data-smith-keep",
      "rowClassName": "smith-option",
      "selection": "multi",
      "commitLabelKey": "blacksmith.category.confirm"
    },
    "rankUpCard": {
      "extends": "optionChoice",
      "className": "option-choice rank-up-pick",
      "idAttribute": "data-rank-up-card",
      "commitLabelKey": "rankUp.pick.confirm",
      "emptyTextKey": "rankUp.pick.none",
      "columns": 1
    },
    "cardChoice": {
      "extends": "optionChoice",
      "className": "option-choice card-choice",
      "idAttribute": "data-choice"
    },
    "discardChoice": {
      "extends": "optionChoice",
      "className": "option-choice discard-choice",
      "idAttribute": "data-discard-id",
      "selection": "multi",
      "atLimit": "swapOldest",
      "hasCancelButton": false,
      "closeLabelKey": "combat.discard.later"
    },
    "reactionChoice": {
      "extends": "optionChoice",
      "className": "option-choice reaction-choice",
      "idAttribute": "data-reaction-option",
      "commitLabelKey": "combat.reaction.play",
      "cancelLabelKey": "common.skip"
    },
    "slotChoice": {
      "extends": "optionChoice",
      "className": "option-choice equip-slot-choice",
      "idAttribute": "data-slot-option",
      "rowClassName": "equip-slot-option",
      "cancelLabelKey": "common.back"
