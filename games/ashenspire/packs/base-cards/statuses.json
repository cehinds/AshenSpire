    {
      "id": "base.greased",
      "name": "Greased",
      "icon": "mana",
      "stackMode": "add",
      "decay": "none",
      "tooltip": "Melee/Reach accuracy -20. At turn start 25% chance to become Prone. Fire cannot miss: triple damage, Burn 3, and splash 1.5 times the original incoming fire damage to other same-side actors."
