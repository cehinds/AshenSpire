  "particles": {
    "rain": {
      "file": "particles/rain.png",
      "tags": {
        "weather": [
          "rain"
        ]
      },
      "opacity": 0.45,
      "coverage": "repeat",
      "tileSizeSourcePixels": 1024,
      "repeatPeriodSourcePixels": 256,
      "motion": {
        "mode": "scroll-repeat",
        "deltaSourcePixels": {
          "x": 256,
          "y": 1024
        },
        "durationMs": 4000,
        "easing": "linear"
      },
      "reducedMotion": "static-or-hidden"
    },
    "snow": {
      "file": "particles/snow.png",
      "tags": {
        "weather": [
          "snow"
        ]
      },
