      "file": "particles/ash.png",
      "tags": {
        "weather": [
          "ash"
        ],
        "biomes": [
          "volcanic",
          "burned"
        ]
      },
      "opacity": 0.5,
      "coverage": "repeat",
      "tileSizeSourcePixels": 1024,
      "repeatPeriodSourcePixels": 256,
      "motion": {
        "mode": "scroll-repeat",
        "deltaSourcePixels": {
          "x": -512,
          "y": 256
        },
        "durationMs": 32000,
        "easing": "linear"
      },
      "reducedMotion": "static-or-hidden"
