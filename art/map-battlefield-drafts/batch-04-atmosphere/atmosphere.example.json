{
  "version": 1,
  "status": "art-preview-contract-not-runtime-implemented",
  "overscan": {
    "mode": "centered-square",
    "sideMultiplierOfLongestViewportEdge": 2,
    "maximumDriftInViewportUnits": {
      "x": 0.2,
      "y": 0.2
    },
    "nativeFilterAndFogCanvas": {
      "width": 4096,
      "height": 4096
    },
    "nativeRasterViewportLongestEdgeLimit": 2048,
    "largerViewportPolicy": "Re-export editable SVG at2x longest viewport edge; do not enlarge a small painted master.",
    "particlePolicy": "Repeat native tile across the entire overscan surface; source is mathematically periodic.",
    "lightningPolicy": "Sparse corrected effect; native frames remain 1672x941 drafts on transparent stages. Production registration and wider coverage remain pending."
  },
  "layerOrder": [
    "sky",
    "distantLightning",
    "rearProps",
    "ground",
    "actors",
    "tintFilters",
    "fog",
    "foregroundParticles",
    "HUD"
  ],
  "filters": {
