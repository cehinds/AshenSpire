  "fog": {
    "file": "fog-vector/fog-overscan-neutral.png",
    "editableSource": "fog-vector/fog-overscan-neutral.svg",
    "tags": {
      "weather": [
        "fog",
        "mist"
      ],
      "biomes": [
        "forest",
        "swamp"
      ]
    },
    "coverage": "overscanSquare",
    "opacity": 0.7,
    "motion": {
      "mode": "oscillate",
      "amplitudeViewportUnits": {
        "x": 0.08,
        "y": 0.025
      },
      "durationMs": 24000
    },
    "reducedMotion": "static"
  },
  "lightning": {
    "tags": {
      "weather": [
        "stormy",
        "thunderstorm"
      ]
    },
    "placement": {
      "space": "scene",
      "position": "distant-upper-right",
      "adjustable": true
    },
    "frames": [
      {
        "file": "../batch-08-style-alignment/lightning-frame-01.png",
        "durationMs": 80,
        "opacity": 0.3
      },
      {
        "file": "../batch-08-style-alignment/lightning-frame-02.png",
        "durationMs": 140,
        "opacity": 0.55
      }
    ],
    "hiddenIntervalMs": {
      "min": 12000,
      "max": 30000
    },
    "initialHiddenIntervalMs": 12000,
    "continuousFastLoop": false,
    "pixelRegistrationVerified": false,
    "reducedMotion": "hidden"
  },
  "combinationRules": {
    "timeOfDay": "Choose one day/night filter.",
    "weatherTone": "Choose one base weather tint; particle and fog layers can be added independently.",
    "temperatureTone": "Choose hot or cold, then tune opacity.",
    "HUD": "Keep HUD outside the tint/weather stack.",
    "gameplay": "These art tags do not apply buffs, damage, encounters or navigation changes."
  },
  "presets": {
    "clearDay": {
      "filters": [
        "day"
      ]
    },
    "night": {
      "filters": [
        "night"
      ]
    },
    "foggy": {
      "filters": [
        "fog"
      ],
      "fog": true
    },
    "storm": {
      "filters": [
        "stormy"
      ],
      "particles": [
        "rain"
      ],
      "lightning": true
    },
    "swamp": {
      "filters": [
        "swamp"
      ],
      "fog": true
    },
    "hot": {
      "filters": [
        "hot"
      ],
      "particles": [
        "ash"
      ]
    },
    "rain": {
      "filters": [
        "rain"
      ],
      "particles": [
        "rain"
      ]
    },
    "cold": {
      "filters": [
        "cold"
      ],
      "particles": [
        "snow"
      ]
    }
  },
  "preview": {
    "background": "../batch-03/preview-misty-composition.png",
    "lightningDemoFirstStrikeMs": 12000,
    "motionDurationMs": 16000,
    "cropCases": [
      {
        "id": "portrait",
