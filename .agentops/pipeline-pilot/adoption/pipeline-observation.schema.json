{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pipeline shadow observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "mode", "source_current_hash", "source_lease", "projected_stage", "projection_drift", "refill_recommendations", "no_safe_assignment", "idle_alarms", "duplicate_assignments", "protected_action_attempts", "packet_characters", "observation_age"],
  "properties": {
    "schema": { "const": "agentops/pipeline-observation/v1" },
    "mode": { "const": "read-only-shadow" },
    "source_current_hash": { "type": "string", "minLength": 1 },
    "source_lease": { "type": ["string", "null"] },
    "projected_stage": { "type": "string", "minLength": 1 },
    "projection_drift": { "type": "integer", "minimum": 0 },
    "refill_recommendations": { "type": "integer", "minimum": 0 },
    "no_safe_assignment": { "type": "integer", "minimum": 0 },
    "idle_alarms": { "type": "integer", "minimum": 0 },
    "duplicate_assignments": { "type": "integer", "minimum": 0 },
    "protected_action_attempts": { "const": 0 },
    "packet_characters": { "type": "integer", "minimum": 0, "maximum": 6000 },
    "observation_age": { "type": "integer", "minimum": 0 }
  }
}
