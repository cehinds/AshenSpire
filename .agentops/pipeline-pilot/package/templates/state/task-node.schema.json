{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable task pipeline node",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "ticket", "objective", "stage", "risk_route", "required_capability", "dependencies", "base_ref", "base_oid", "owner", "writer", "resource_locks", "first_action", "done_when", "evidence", "blocker"],
  "properties": {
    "schema": { "const": "task-pipeline-node/v1" },
    "id": { "type": "string", "minLength": 1 },
    "ticket": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["intake", "ready", "executing", "review", "integrate", "delivered", "closed", "blocked", "needs-decision", "cancelled"] },
    "risk_route": { "type": "string", "minLength": 1 },
    "required_capability": { "type": "string", "minLength": 1 },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "base_ref": { "type": "string", "minLength": 1 },
    "base_oid": { "type": ["string", "null"] },
    "owner": { "type": ["string", "null"] },
    "writer": { "type": ["string", "null"] },
    "resource_locks": { "type": "array", "items": { "type": "string" } },
    "first_action": { "type": "string", "minLength": 1 },
    "done_when": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "blocker": { "type": ["object", "null"] }
  }
}
