{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AshenSpire task pipeline node",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "node_id", "ticket", "objective", "priority", "risk_route",
    "state", "required_capability", "dependencies", "base_ref", "base_oid",
    "owner", "writer", "first_action", "done_when", "affected_paths", "resource_locks",
    "evidence_targets", "blocker", "next_stage"
  ],
  "properties": {
    "schema": { "const": "agentops/task-node/v1" },
    "node_id": { "type": "string", "minLength": 1 },
    "ticket": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "priority": { "enum": ["T0", "T1", "T2", "T3", "T4"] },
    "risk_route": { "type": "string", "minLength": 1 },
    "state": { "enum": ["intake", "ready", "executing", "review", "integrate", "delivered", "closed", "needs-decision", "blocked", "cancelled"] },
    "required_capability": { "type": "string", "minLength": 1 },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "base_ref": { "type": "string", "minLength": 1 },
    "base_oid": { "type": ["string", "null"] },
    "owner": { "type": ["string", "null"] },
    "writer": { "type": ["string", "null"] },
    "first_action": { "type": "string", "minLength": 1 },
    "done_when": { "type": "string", "minLength": 1 },
    "affected_paths": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "resource_locks": { "type": "array", "items": { "type": "string" } },
    "evidence_targets": { "type": "array", "items": { "type": "string" } },
    "blocker": { "type": ["object", "null"] },
    "next_stage": { "type": ["string", "null"] }
  }
}
