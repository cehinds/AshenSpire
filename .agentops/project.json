{
  "schema": "agentops/project/v1",
  "policy_version": "1.0.0",
  "project_name": "AshenSpire",
  "repository": "https://github.com/cehinds/AshenSpire.git",
  "default_branch": "main",
  "development_branch": "dev",
  "engine_stack": "node-esm-stdlib; browser single-file HTML build",
  "providers": "PROVIDER_NEUTRAL",
  "risk_profile": "STANDARD",
  "startup_token_target": 1200,
  "startup_token_hard_limit": 1500,
  "blocker_routing_sla_minutes": 5,
  "pages_owner_hud": "PLANNED",
  "owner_command_path": "WORKFLOW_FORMS",
  "control_plane_root": ".agentops",
  "installed_stage": "runtime-capsules",
  "installed_contracts": [
    "governance/owner-intent.json",
    "governance/hierarchy.json",
    "governance/roles.json",
    "governance/authority.json",
    "governance/git-ownership.json",
    "governance/raci.json",
    "governance/delegation.json",
    "governance/escalation.json",
    "governance/transitions.json",
    "governance/information-access.json",
    "governance/qa.json",
    "governance/evidence.json"
  ],
  "runtime_artifacts": {
    "work_capsule": "work/<ticket>/CURRENT.json (schema work-capsule/v1, sealed with a compare-and-swap current_hash)",
    "writer_lease": "leases/<lease-id>.json (schema lease/v1, one writer per overlapping path/ref)",
    "event": "events/<ticket>/<event-id>.json (schema event/v1, append-only chain)",
    "wake_compiler": "opsctl wake --actor <role> --work <ticket> (token-bounded disposable capsule)",
    "seed_ticket": "AS-1001"
  },
  "deferred_next_stages": [
    "clean-clone / context-wipe reconstruction drills (Claude + Codex)",
    "owner-command workflows (authenticated decision path)",
    "pages owner HUD (read-only projection)",
    "migration tooling for existing work",
    "independent review then exact dev -> main promotion decision"
  ]
}
