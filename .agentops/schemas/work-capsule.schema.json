{
  "$schema": "agentops-mini-schema/v1",
  "title": "work-capsule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "revision",
    "current_hash",
    "parent_hash",
    "ticket",
    "lifecycle_state",
    "objective",
    "done_when",
    "next_action",
    "repo",
    "ref",
    "base_oid",
    "tree",
    "expected_dirty_state",
    "owner_actor",
    "writer_lease",
    "affected_paths",
    "evidence_pointers",
    "blocker",
    "authority",
    "rollback",
    "invalidation_keys"
  ],
  "properties": {
    "schema": {
      "const": "agentops/work-capsule/v1"
    },
    "revision": {
      "type": "integer"
    },
    "current_hash": {
      "type": "string",
      "minLength": 1
    },
    "parent_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "ticket": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle_state": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "done_when": {
      "type": "string",
      "minLength": 1
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "base_oid": {
      "type": "string",
      "minLength": 1
    },
    "tree": {
      "type": "string",
      "minLength": 1
    },
    "expected_dirty_state": {
      "enum": [
        "clean",
        "dirty-exported"
      ]
    },
    "owner_actor": {
      "type": "string",
      "minLength": 1
    },
    "writer_lease": {
      "type": "string",
      "minLength": 1
    },
    "affected_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "evidence_pointers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blocker": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "kind",
        "escalation_class",
        "summary"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "escalation_class": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may",
        "must_not",
        "expiry"
      ],
      "properties": {
        "may": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "must_not": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expiry": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtime_residue": {
      "type": "string"
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    },
    "invalidation_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "team": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_effort": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "model",
        "effort",
        "why",
        "escalate_when"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string",
          "minLength": 1
        },
        "escalate_when": {
          "type": "string",
          "minLength": 1
        },
        "exceptional_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "self_certification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certifying_seat",
        "approving_lead",
        "team",
        "risk_class",
        "envelope",
        "exact_head",
        "suites_run",
        "why_independence_was_waived",
        "verdict_kind"
      ],
      "properties": {
        "certifying_seat": {
          "type": "string",
          "minLength": 1
        },
        "approving_lead": {
          "type": "string",
          "minLength": 1
        },
        "team": {
          "type": "string",
          "minLength": 1
        },
        "envelope": {
          "type": "string",
          "minLength": 1
        },
        "exact_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "suites_run": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "why_independence_was_waived": {
          "type": "string",
          "minLength": 1
        },
        "verdict_kind": {
          "const": "self-certified"
        },
        "risk_class": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
