{
  "$schema": "agentops-mini-schema/v1",
  "title": "event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "ticket", "seq", "parent_event", "kind", "actor", "at", "summary"],
  "properties": {
    "schema": {"const": "agentops/event/v1"},
    "id": {"type": "string", "minLength": 1},
    "ticket": {"type": "string", "minLength": 1},
    "seq": {"type": "integer"},
    "parent_event": {"type": ["string", "null"]},
    "kind": {"enum": ["genesis", "assigned", "lease-issued", "state-change", "evidence-recorded", "blocker", "lease-revoked", "resolved", "owner-decision"]},
    "actor": {"type": "string", "minLength": 1},
    "at": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "evidence_pointer": {"type": "string", "minLength": 1},
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "authenticated_role", "authority_path", "target", "expected_current_hash", "candidate_oid"],
      "properties": {
        "action": {"type": "string", "minLength": 1},
        "authenticated_role": {"type": "string", "minLength": 1},
        "authority_path": {"const": ".github/workflows/owner-command.yml:owner-command/v1"},
        "target": {"type": "string", "minLength": 1},
        "expected_current_hash": {"type": ["string", "null"]},
        "candidate_oid": {"type": ["string", "null"]},
        "scheduler_migration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scheduler_head",
            "scheduler_tree",
            "source_state_oid",
            "source_state_tree",
            "source_snapshot_sha256",
            "source_journal_manifest_sha256",
            "source_event_count",
            "source_state_version",
            "target_state_version",
            "canonical_anchor_oid",
            "preserved_local_tip_oid",
            "dispatch_frozen",
            "one_use",
            "expires_at",
            "target_ref",
            "expected_remote_oid",
            "push_mode",
            "abort_on_remote_change"
          ],
          "properties": {
            "scheduler_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "scheduler_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "source_state_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "source_state_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "source_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "source_journal_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "source_event_count": {"type": "integer"},
            "source_state_version": {"const": 1},
            "target_state_version": {"const": 2},
            "canonical_anchor_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "preserved_local_tip_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "dispatch_frozen": {"const": true},
            "one_use": {"const": true},
            "expires_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$"},
            "target_ref": {"const": "refs/heads/agentops/scheduler-state"},
            "expected_remote_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "push_mode": {"const": "non-force-forward-only-cas"},
            "abort_on_remote_change": {"const": true}
          }
        },
        "project_schema_change": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema", "executor_head", "executor_tree", "project", "authenticated_login", "required_scope",
            "project_updated_at", "preflight", "definitions_hash", "mode", "allowed_mutation", "forbid_item_mutation",
            "forbid_existing_field_update", "forbid_backfill", "abort_on_any_drift", "retry_mode", "one_use", "expires_at",
            "audit_ref", "expected_audit_remote_oid", "audit_push_mode", "journal_mode", "recovery_mode", "audit_paths", "audit_guards", "audit_result_contract"
          ],
          "properties": {
            "schema": {"const": "agentops/project-schema-change-authority/v2"},
            "executor_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "executor_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "project": {
              "type": "object",
              "additionalProperties": false,
              "required": ["owner", "owner_type", "number", "id", "title", "closed"],
              "properties": {
                "owner": {"const": "cehinds"},
                "owner_type": {"const": "user"},
                "number": {"const": 4},
                "id": {"const": "PVT_kwHOCSCyJ84BgfH9"},
                "title": {"const": "Family Delivery"},
                "closed": {"const": false}
              }
            },
            "authenticated_login": {"const": "cehinds"},
            "required_scope": {"const": "project"},
            "project_updated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$"},
            "preflight": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field_count", "field_state_root", "item_count", "field_value_count", "item_state_root", "pagination_manifest_hash", "priority_field_id", "priority_contract_hash"],
              "properties": {
                "field_count": {"type": "integer"},
                "field_state_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "item_count": {"type": "integer"},
                "field_value_count": {"type": "integer"},
                "item_state_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "pagination_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "priority_field_id": {"const": "PVTSSF_lAHOCSCyJ84BgfH9zhfelc4"},
                "priority_contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            },
            "definitions_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "mode": {"const": "create-missing-only"},
            "allowed_mutation": {"const": "project-field-create"},
            "forbid_item_mutation": {"const": true},
            "forbid_existing_field_update": {"const": true},
            "forbid_backfill": {"const": true},
            "abort_on_any_drift": {"const": true},
            "retry_mode": {"const": "never"},
            "one_use": {"const": true},
            "expires_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$"},
            "audit_ref": {"const": "refs/heads/agentops/project-schema-audit"},
            "expected_audit_remote_oid": {"const": null},
            "audit_push_mode": {"const": "create-if-absent-then-non-force-forward-only-cas"},
            "journal_mode": {"const": "append-only-intent-result"},
            "recovery_mode": {"const": "inspect-once-never-create"},
            "audit_paths": {
              "type": "object",
              "additionalProperties": false,
              "required": ["root", "journal_path", "attempt_path_template", "receipt_path_template"],
              "properties": {
                "root": {"const": ".agentops/scheduler/project-schema-attempts"},
                "journal_path": {"const": ".agentops/scheduler/project-schema-attempts/journal.jsonl"},
                "attempt_path_template": {"const": ".agentops/scheduler/project-schema-attempts/attempts/{attempt_id}.json"},
                "receipt_path_template": {"const": ".agentops/scheduler/project-schema-attempts/receipts/{attempt_id}.json"}
              }
            },
            "audit_guards": {
              "type": "object",
              "additionalProperties": false,
              "required": ["expected_absence", "initial_commit_parent_binding", "initial_creation_authorized_if_absent", "subsequent_linear_direct_successors", "allowed_mutation", "intent_before_each_create", "result_after_each_response", "consumed_create_retry_forbidden", "read_only_recovery", "ref_recreation_forbidden", "development_ref_mutation_forbidden"],
              "properties": {
                "expected_absence": {"const": true},
                "initial_commit_parent_binding": {"const": "derived-owner-authority-a"},
                "initial_creation_authorized_if_absent": {"const": true},
                "subsequent_linear_direct_successors": {"const": true},
                "allowed_mutation": {"const": "append-intent-result-attempt-and-receipt-records-only"},
                "intent_before_each_create": {"const": true},
                "result_after_each_response": {"const": true},
                "consumed_create_retry_forbidden": {"const": true},
                "read_only_recovery": {"const": true},
                "ref_recreation_forbidden": {"const": true},
                "development_ref_mutation_forbidden": {"const": true}
              }
            },
            "audit_result_contract": {
              "type": "object",
              "additionalProperties": false,
              "required": ["schema", "result_schema", "path", "schema_pointer", "construction_timing", "ambiguity_policy", "no_self_reference"],
              "properties": {
                "schema": {"const": "agentops/project-schema-audit-result-contract/v1"},
                "result_schema": {"const": "agentops/project-schema-audit-result/v1"},
                "path": {"const": ".git/agentops-project-schema/audit-result.json"},
                "schema_pointer": {"const": ".agentops/schemas/owner-command-request.schema.json#/definitions/project_schema_audit_result_receipt"},
                "construction_timing": {"const": "after-local-initial-commit-before-ref-creation"},
                "ambiguity_policy": {"const": "inspect-once-never-create"},
                "no_self_reference": {"const": true}
              }
            }
          }
        },
        "scheduler_state_reconciliation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema", "reconciler_head", "reconciler_tree", "source", "target", "canonical_anchor_oid", "machine_lease",
            "work_leases", "mode", "not_before", "quiet_window_receipt_hash", "expected_event_count_delta", "dispatch_frozen",
            "no_refill", "no_assignment", "no_dispatch", "no_external_mutation", "one_use", "expires_at", "target_ref",
            "expected_remote_oid", "push_mode", "abort_on_remote_change"
          ],
          "properties": {
            "schema": {"const": "agentops/scheduler-state-reconciliation-authority/v1"},
            "reconciler_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "reconciler_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": ["state_oid", "state_tree", "snapshot_sha256", "journal_manifest_sha256", "event_count", "state_version"],
              "properties": {
                "state_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "state_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "journal_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "event_count": {"type": "integer"},
                "state_version": {"type": "integer"}
              }
            },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "required": ["state_oid", "state_tree", "snapshot_sha256", "journal_manifest_sha256", "event_count"],
              "properties": {
                "state_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "state_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "journal_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "event_count": {"type": "integer"}
              }
            },
            "canonical_anchor_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "machine_lease": {
              "type": "object",
              "additionalProperties": false,
              "required": ["machine_id", "lease_epoch", "acquired_at", "released_at", "expires_at", "expected_state_ref_oid"],
              "properties": {
                "machine_id": {"type": ["string", "null"]},
                "lease_epoch": {"type": "integer"},
                "acquired_at": {"type": ["string", "null"]},
                "released_at": {"type": ["string", "null"]},
                "expires_at": {"type": "string", "minLength": 1},
                "expected_state_ref_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
              }
            },
            "work_leases": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["issue_id", "state", "assigned_actor", "assignment_kind", "lease_id", "lease_epoch", "lease_expiry", "lease_machine_id", "base_commit"],
                "properties": {
                  "issue_id": {"type": "string", "pattern": "^#[1-9][0-9]*$"},
                  "state": {"type": "string", "minLength": 1},
                  "assigned_actor": {"type": ["string", "null"]},
                  "assignment_kind": {"type": ["string", "null"]},
                  "lease_id": {"type": ["string", "null"]},
                  "lease_epoch": {"type": ["integer", "null"]},
                  "lease_expiry": {"type": ["string", "null"]},
                  "lease_machine_id": {"type": ["string", "null"]},
                  "base_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
                }
              }
            },
            "mode": {"const": "release-custody-and-reconcile-work-leases"},
            "not_before": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$"},
            "quiet_window_receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "expected_event_count_delta": {"type": "integer"},
            "dispatch_frozen": {"const": true},
            "no_refill": {"const": true},
            "no_assignment": {"const": true},
            "no_dispatch": {"const": true},
            "no_external_mutation": {"const": true},
            "one_use": {"const": true},
            "expires_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$"},
            "target_ref": {"const": "refs/heads/agentops/scheduler-state"},
            "expected_remote_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "push_mode": {"const": "non-force-forward-only-cas"},
            "abort_on_remote_change": {"const": true}
          }
        },
        "scheduler_cutover": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema", "scheduler_head", "scheduler_tree", "qa_receipt", "migration", "current_state",
            "project_schema_receipt", "project_manifest", "quiet_window_receipt",
            "active_work_lease_count", "legacy_activation", "pre_cutover_config", "post_cutover_config", "activation_manifest", "result_receipt_contract", "cross_field_equalities",
            "state_target_ref", "expected_state_remote_oid", "development_ref", "expected_development_remote_oid", "publication_mode",
            "ambiguity_policy", "postcondition_policy", "one_use", "expires_at", "push_mode", "abort_on_remote_change"
          ],
          "properties": {
            "schema": {"const": "agentops/scheduler-cutover-authority/v2"},
            "scheduler_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "scheduler_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "qa_receipt": {
              "type": "object",
              "additionalProperties": false,
              "required": ["schema", "path", "blob_oid", "sha256"],
              "properties": {
                "schema": {"const": "agentops/independent-qa-receipt/v1"},
                "path": {"const": ".agentops/scheduler/cutover/qa-receipt.json"},
                "blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            },
            "migration": {
              "type": "object",
              "additionalProperties": false,
              "required": ["boundary_oid", "state_migrated_event"],
              "properties": {
                "boundary_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "state_migrated_event": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["schema", "path", "blob_oid", "sha256", "semantics"],
                  "properties": {
                    "schema": {"const": "agentops/scheduler-event/v2"},
                    "path": {"type": "string", "pattern": "^journal/[0-9]{8}-[A-Za-z0-9._-]+\\.json$"},
                    "blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "semantics": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["event_version", "event_type", "issue_id", "payload_schema", "dispatch_frozen", "single_migration_boundary", "boundary_commit_binding"],
                      "properties": {
                        "event_version": {"const": 2},
                        "event_type": {"const": "STATE_MIGRATED"},
                        "issue_id": {"const": "scheduler-state"},
                        "payload_schema": {"const": "agentops/scheduler-migration/v2"},
                        "dispatch_frozen": {"const": true},
                        "single_migration_boundary": {"const": true},
                        "boundary_commit_binding": {"const": "migration.boundary_oid"}
                      }
                    }
                  }
                }
              }
            },
            "current_state": {
              "type": "object",
              "additionalProperties": false,
              "required": ["oid", "tree", "released_custody"],
              "properties": {
                "oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "released_custody": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["schema", "path", "blob_oid", "sha256", "semantics"],
                  "properties": {
                    "schema": {"const": "agentops/scheduler-machine-lease/v1"},
                    "path": {"const": "machine-lease.json"},
                    "blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "semantics": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["machine_id", "acquired_at", "released_at_required", "expires_at_equals_released_at", "expected_state_ref_oid_binding"],
                      "properties": {
                        "machine_id": {"const": null},
                        "acquired_at": {"const": null},
                        "released_at_required": {"const": true},
                        "expires_at_equals_released_at": {"const": true},
                        "expected_state_ref_oid_binding": {"const": "current_state.oid"}
                      }
                    }
                  }
                }
              }
            },
            "project_schema_receipt": {
              "type": "object",
              "additionalProperties": false,
              "required": ["schema", "path", "blob_oid", "sha256"],
              "properties": {
                "schema": {"const": "agentops/project-schema-change-receipt/v1"},
                "path": {"const": ".agentops/scheduler/cutover/project-schema-receipt.json"},
                "blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            },
            "project_manifest": {
              "type": "object",
              "additionalProperties": false,
              "required": ["schema", "path", "blob_oid", "sha256"],
              "properties": {
                "schema": {"const": "agentops/project-field-manifest/v1"},
                "path": {"const": ".agentops/scheduler/cutover/project-manifest.json"},
                "blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            },
            "quiet_window_receipt": {
              "type": "object",
              "additionalProperties": false,
              "required": ["schema", "path", "blob_oid", "sha256"],
              "properties": {
                "schema": {"const": "agentops/scheduler-quiet-window-receipt/v1"},
                "path": {"const": ".agentops/scheduler/cutover/quiet-window-receipt.json"},
                "blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            },
            "active_work_lease_count": {"const": 0},
            "legacy_activation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["schema", "path", "blob_oid", "sha256", "semantics"],
              "properties": {
                "schema": {"const": "agentops/pipeline-activation/v1"},
                "path": {"const": ".agentops/pipeline-pilot/activation.json"},
                "blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "semantics": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["enabled", "mode"],
                  "properties": {
                    "enabled": {"const": false},
                    "mode": {"const": "STOOD_DOWN_FOR_SCHEDULER_CUTOVER"}
                  }
                }
              }
            },
            "pre_cutover_config": {
              "type": "object",
              "additionalProperties": false,
              "required": ["schema", "path", "blob_oid", "sha256", "semantics"],
              "properties": {
                "schema": {"const": "agentops/scheduler-config/v1"},
                "path": {"const": ".agentops/scheduler/config.json"},
                "blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "semantics": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["scheduler_dispatch_enabled", "legacy_watcher_authoritative", "scheduler_authorization_evidence", "migration_dispatch_frozen"],
                  "properties": {
                    "scheduler_dispatch_enabled": {"const": false},
                    "legacy_watcher_authoritative": {"const": false},
                    "scheduler_authorization_evidence": {"const": null},
                    "migration_dispatch_frozen": {"const": true}
                  }
                }
              }
            },
            "post_cutover_config": {
              "type": "object",
              "additionalProperties": false,
              "required": ["schema", "path", "blob_oid", "sha256", "semantics"],
              "properties": {
                "schema": {"const": "agentops/scheduler-config/v1"},
                "path": {"const": ".agentops/scheduler/config.json"},
                "blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "semantics": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["scheduler_dispatch_enabled", "legacy_watcher_authoritative", "scheduler_authorization_evidence_binding", "migration_dispatch_frozen"],
                  "properties": {
                    "scheduler_dispatch_enabled": {"const": true},
                    "legacy_watcher_authoritative": {"const": false},
                    "scheduler_authorization_evidence_binding": {"const": "canonical-owner-event-in-direct-parent-a-by-path-and-id-no-hash"},
                    "migration_dispatch_frozen": {"const": true}
                  }
                }
              }
            },
            "activation_manifest": {
              "type": "object",
              "additionalProperties": false,
              "required": ["schema", "path", "blob_oid", "sha256", "blob_parse_policy", "template"],
              "properties": {
                "schema": {"const": "agentops/scheduler-cutover-activation-manifest/v1"},
                "path": {"const": ".agentops/scheduler/cutover/activation-manifest.json"},
                "blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "blob_parse_policy": {"const": "parse-json-and-deep-equal-inline-template"},
                "template": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["schema", "development_d0", "state_s0", "authority_a_derivation", "state_s1_derivation", "development_d1_derivation", "all_off_precondition", "derivation_order", "no_self_reference"],
                  "properties": {
                    "schema": {"const": "agentops/scheduler-cutover-activation-template/v1"},
                    "development_d0": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["oid", "tree", "legacy_activation_blob_oid", "pre_cutover_config_blob_oid", "post_cutover_config_blob_oid"],
                      "properties": {
                        "oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                        "legacy_activation_blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                        "pre_cutover_config_blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                        "post_cutover_config_blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
                      }
                    },
                    "state_s0": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["oid", "tree"],
                      "properties": {
                        "oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
                      }
                    },
                    "authority_a_derivation": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["parent_binding", "parent_count", "source_paths", "cutover_evidence_paths", "deterministic_render_paths", "unchanged_render_bytes_omitted", "other_changes_forbidden"],
                      "properties": {
                        "parent_binding": {"const": "expected_development_remote_oid"},
                        "parent_count": {"const": 1},
                        "source_paths": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["owner_event_path_template", "target_capsule_path_template"],
                          "properties": {
                            "owner_event_path_template": {"const": ".agentops/events/{target}/{event_id}.json"},
                            "target_capsule_path_template": {"const": ".agentops/work/{target}/CURRENT.json"}
                          }
                        },
                        "cutover_evidence_paths": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["qa_receipt", "project_schema_receipt", "project_manifest", "quiet_window_receipt", "activation_manifest"],
                          "properties": {
                            "qa_receipt": {"const": ".agentops/scheduler/cutover/qa-receipt.json"},
                            "project_schema_receipt": {"const": ".agentops/scheduler/cutover/project-schema-receipt.json"},
                            "project_manifest": {"const": ".agentops/scheduler/cutover/project-manifest.json"},
                            "quiet_window_receipt": {"const": ".agentops/scheduler/cutover/quiet-window-receipt.json"},
                            "activation_manifest": {"const": ".agentops/scheduler/cutover/activation-manifest.json"}
                          }
                        },
                        "deterministic_render_paths": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["governance", "hud", "decisions", "published_hud", "published_decisions"],
                          "properties": {
                            "governance": {"const": ".agentops/generated/GOVERNANCE.md"},
                            "hud": {"const": ".agentops/generated/hud/index.html"},
                            "decisions": {"const": ".agentops/generated/hub/decisions.html"},
                            "published_hud": {"const": "docs/generated/hud/index.html"},
                            "published_decisions": {"const": "docs/generated/hub/decisions.html"}
                          }
                        },
                        "unchanged_render_bytes_omitted": {"const": true},
                        "other_changes_forbidden": {"const": true}
                      }
                    },
                    "state_s1_derivation": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["parent_binding", "parent_count", "activation_event", "snapshot_path", "preserved_paths_policy", "other_changes_forbidden"],
                      "properties": {
                        "parent_binding": {"const": "expected_state_remote_oid"},
                        "parent_count": {"const": 1},
                        "activation_event": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["path_template", "schema", "payload_schema", "event_version", "event_type", "issue_id", "actor", "machine_id", "lease_id", "lease_epoch", "source_binding", "authority_binding", "count"],
                          "properties": {
                            "path_template": {"const": "journal/{sequence:08}-{event_id}.json"},
                            "schema": {"const": "agentops/scheduler-event/v2"},
                            "payload_schema": {"const": "agentops/scheduler-activation/v2"},
                            "event_version": {"const": 2},
                            "event_type": {"const": "SCHEDULER_ACTIVATED"},
                            "issue_id": {"const": "scheduler-state"},
                            "actor": {"const": "it-manager-iii"},
                            "machine_id": {"const": null},
                            "lease_id": {"const": null},
                            "lease_epoch": {"const": null},
                            "source_binding": {"const": "current_state"},
                            "authority_binding": {"const": "canonical-owner-event-in-derived-authority-a"},
                            "count": {"const": 1}
                          }
                        },
                        "snapshot_path": {"const": "snapshot.json"},
                        "preserved_paths_policy": {"const": "all-prior-journal-machine-lease-and-state-version-blobs-byte-identical"},
                        "other_changes_forbidden": {"const": true}
                      }
                    },
                    "development_d1_derivation": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["parent_binding", "parent_count", "scheduler_config_path", "scheduler_config_blob_binding", "authority_evidence_mode", "other_changes_forbidden"],
                      "properties": {
                        "parent_binding": {"const": "derived-authority-a"},
                        "parent_count": {"const": 1},
                        "scheduler_config_path": {"const": ".agentops/scheduler/config.json"},
                        "scheduler_config_blob_binding": {"const": "post_cutover_config.blob_oid"},
                        "authority_evidence_mode": {"const": "canonical-owner-event-in-direct-parent-a-by-path-and-id-no-hash"},
                        "other_changes_forbidden": {"const": true}
                      }
                    },
                    "all_off_precondition": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["scheduler_dispatch_enabled", "legacy_watcher_authoritative", "scheduler_authorization_evidence", "migration_dispatch_frozen", "legacy_activation_enabled", "legacy_activation_mode"],
                      "properties": {
                        "scheduler_dispatch_enabled": {"const": false},
                        "legacy_watcher_authoritative": {"const": false},
                        "scheduler_authorization_evidence": {"const": null},
                        "migration_dispatch_frozen": {"const": true},
                        "legacy_activation_enabled": {"const": false},
                        "legacy_activation_mode": {"const": "STOOD_DOWN_FOR_SCHEDULER_CUTOVER"}
                      }
                    },
                    "derivation_order": {"const": "build-a-from-d0-build-s1-from-s0-build-d1-from-a-record-result-then-publish-s1-d1-atomically"},
                    "no_self_reference": {"const": true}
                  }
                }
              }
            },
            "result_receipt_contract": {
              "type": "object",
              "additionalProperties": false,
              "required": ["schema", "result_schema", "path", "schema_pointer", "construction_timing", "publication_gate", "no_self_reference"],
              "properties": {
                "schema": {"const": "agentops/scheduler-cutover-result-contract/v1"},
                "result_schema": {"const": "agentops/scheduler-cutover-result/v1"},
                "path": {"const": ".git/agentops-scheduler/cutover-result.json"},
                "schema_pointer": {"const": ".agentops/schemas/owner-command-request.schema.json#/definitions/scheduler_cutover_result_receipt"},
                "construction_timing": {"const": "after-local-derivation-before-publication"},
                "publication_gate": {"const": "prebuilt-a-s1-d1-match-derivation-template"},
                "no_self_reference": {"const": true}
              }
            },
            "cross_field_equalities": {
              "type": "object",
              "additionalProperties": false,
              "required": ["development_d0_oid", "state_s0_oid", "state_s0_tree", "legacy_activation_blob", "pre_cutover_config_blob", "post_cutover_config_blob", "expected_state_remote", "migration_boundary_event_blob"],
              "properties": {
                "development_d0_oid": {"const": "activation_manifest.template.development_d0.oid == expected_development_remote_oid"},
                "state_s0_oid": {"const": "activation_manifest.template.state_s0.oid == current_state.oid"},
                "state_s0_tree": {"const": "activation_manifest.template.state_s0.tree == current_state.tree"},
                "legacy_activation_blob": {"const": "activation_manifest.template.development_d0.legacy_activation_blob_oid == legacy_activation.blob_oid"},
                "pre_cutover_config_blob": {"const": "activation_manifest.template.development_d0.pre_cutover_config_blob_oid == pre_cutover_config.blob_oid"},
                "post_cutover_config_blob": {"const": "activation_manifest.template.development_d0.post_cutover_config_blob_oid == post_cutover_config.blob_oid"},
                "expected_state_remote": {"const": "expected_state_remote_oid == current_state.oid"},
                "migration_boundary_event_blob": {"const": "migration.state_migrated_event.blob_oid exists at migration.boundary_oid:migration.state_migrated_event.path"}
              }
            },
            "state_target_ref": {"const": "refs/heads/agentops/scheduler-state"},
            "expected_state_remote_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "development_ref": {"const": "refs/heads/dev"},
            "expected_development_remote_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "publication_mode": {"const": "atomic-two-ref-cas"},
            "ambiguity_policy": {"const": "inspect-once-never-retry"},
            "postcondition_policy": {"const": "both-exact-or-withhold"},
            "one_use": {"const": true},
            "expires_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$"},
            "push_mode": {"const": "git-push-atomic-two-ref-exact-leases"},
            "abort_on_remote_change": {"const": true}
          }
        }
      }
    }
  },
  "definitions": {
    "project_schema_audit_result_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "initial_commit", "publication", "postinspection"],
      "properties": {
        "schema": {"const": "agentops/project-schema-audit-result/v1"},
        "initial_commit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["oid", "tree", "parent_oid"],
          "properties": {
            "oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "parent_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        },
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "expected_absent", "target_oid", "push_mode", "push_exit_code"],
          "properties": {
            "ref": {"const": "refs/heads/agentops/project-schema-audit"},
            "expected_absent": {"const": true},
            "target_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "push_mode": {"const": "create-if-absent"},
            "push_exit_code": {"type": ["integer", "null"]}
          }
        },
        "postinspection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inspection_count", "retry_create_permitted", "actual_oid", "target_exact", "outcome", "policy"],
          "properties": {
            "inspection_count": {"const": 1},
            "retry_create_permitted": {"const": false},
            "actual_oid": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
            "target_exact": {"type": "boolean"},
            "outcome": {"enum": ["EXACT", "ABSENT", "OTHER"]},
            "policy": {"const": "exact-target-or-withhold-never-create-again"}
          }
        }
      }
    },
    "scheduler_cutover_result_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "authority_a", "state_s1", "development_d1", "publication", "postinspection"],
      "properties": {
        "schema": {"const": "agentops/scheduler-cutover-result/v1"},
        "authority_a": {
          "type": "object",
          "additionalProperties": false,
          "required": ["oid", "tree", "parent_oid"],
          "properties": {
            "oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "parent_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        },
        "state_s1": {
          "type": "object",
          "additionalProperties": false,
          "required": ["oid", "tree", "parent_oid", "activation_event"],
          "properties": {
            "oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "parent_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "activation_event": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "blob_oid", "sha256"],
              "properties": {
                "path": {"type": "string", "pattern": "^journal/[0-9]{8}-[A-Za-z0-9._-]+\\.json$"},
                "blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        },
        "development_d1": {
          "type": "object",
          "additionalProperties": false,
          "required": ["oid", "tree", "parent_oid", "scheduler_config"],
          "properties": {
            "oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "parent_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "scheduler_config": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "blob_oid", "sha256"],
              "properties": {
                "path": {"const": ".agentops/scheduler/config.json"},
                "blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        },
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "attempted_at", "state", "development", "atomic_push_exit_code"],
          "properties": {
            "mode": {"const": "git-push-atomic-two-ref-exact-leases"},
            "attempted_at": {"type": "string", "minLength": 1},
            "state": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ref", "expected_oid", "target_oid"],
              "properties": {
                "ref": {"const": "refs/heads/agentops/scheduler-state"},
                "expected_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "target_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
              }
            },
            "development": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ref", "expected_oid", "target_oid"],
              "properties": {
                "ref": {"const": "refs/heads/dev"},
                "expected_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "target_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
              }
            },
            "atomic_push_exit_code": {"type": ["integer", "null"]}
          }
        },
        "postinspection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inspection_count", "retry_permitted", "state_actual_oid", "development_actual_oid", "state_exact", "development_exact", "outcome", "dispatch_permitted", "policy"],
          "properties": {
            "inspection_count": {"const": 1},
            "retry_permitted": {"const": false},
            "state_actual_oid": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
            "development_actual_oid": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
            "state_exact": {"type": "boolean"},
            "development_exact": {"type": "boolean"},
            "outcome": {"enum": ["BOTH_EXACT", "MIXED", "NEITHER"]},
            "dispatch_permitted": {"type": "boolean"},
            "policy": {"const": "dispatch-only-on-both-exact-otherwise-withhold"}
          }
        }
      }
    }
  }
}
