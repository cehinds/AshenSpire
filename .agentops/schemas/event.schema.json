{
  "$schema": "agentops-mini-schema/v1",
  "title": "event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "ticket",
    "seq",
    "parent_event",
    "kind",
    "actor",
    "at",
    "summary"
  ],
  "properties": {
    "schema": {
      "const": "agentops/event/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "ticket": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer"
    },
    "parent_event": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "enum": [
        "genesis",
        "assigned",
        "lease-issued",
        "state-change",
        "evidence-recorded",
        "blocker",
        "lease-revoked",
        "resolved",
        "owner-decision",
        "consolidation"
      ]
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "at": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "consolidates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_event",
        "to_event",
        "count",
        "authorised_by",
        "recovery_consequence"
      ],
      "properties": {
        "from_event": {
          "type": "string",
          "minLength": 1
        },
        "to_event": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "number"
        },
        "authorised_by": {
          "type": "string",
          "minLength": 1
        },
        "recovery_consequence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "from",
        "to",
        "hosted_verified_dev_oid",
        "evidence"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "to": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "hosted_verified_dev_oid": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence_pointer": {
      "type": "string",
      "minLength": 1
    }
  }
}
