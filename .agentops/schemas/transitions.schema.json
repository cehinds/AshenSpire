{
  "$schema": "agentops-mini-schema/v1",
  "title": "transitions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_version", "principle", "states", "protected_states", "transitions", "rules"],
  "properties": {
    "schema": {"const": "agentops/transitions/v1"},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "principle": {"type": "string", "minLength": 1},
    "states": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "protected_states": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "guard", "permitted_actor_roles", "protected"],
        "properties": {
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "guard": {"type": "string", "minLength": 1},
          "permitted_actor_roles": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "protected": {"type": "boolean"}
        }
      }
    },
    "rules": {"type": "object"}
  }
}
