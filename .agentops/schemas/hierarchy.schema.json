{
  "$schema": "agentops-mini-schema/v1",
  "title": "hierarchy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_version", "nodes", "escalation_routing"],
  "properties": {
    "schema": {"const": "agentops/hierarchy/v1"},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor_id", "role", "escalation_parent", "owns_escalations"],
        "properties": {
          "actor_id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "escalation_parent": {"type": ["string", "null"]},
          "owns_escalations": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "escalation_routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_sla_minutes", "deputy_custody_at_minutes", "deputy_overdue_to_owner_at_minutes", "immediate_owner_classes"],
      "properties": {
        "default_sla_minutes": {"type": "integer"},
        "deputy_custody_at_minutes": {"type": "integer"},
        "deputy_overdue_to_owner_at_minutes": {"type": "integer"},
        "immediate_owner_classes": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "note": {"type": "string"}
      }
    }
  }
}
