{
  "$schema": "agentops-mini-schema/v1",
  "title": "owner-command",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_version", "principle", "authenticated_actors", "actions", "rules"],
  "properties": {
    "schema": {"const": "agentops/owner-command/v1"},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "principle": {"type": "string", "minLength": 1},
    "authenticated_actors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "deputy"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "deputy": {"type": "string", "minLength": 1}
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "authenticator_roles", "requires_cas", "protected", "required_fields", "affects"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "authenticator_roles": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "requires_cas": {"type": "boolean"},
          "protected": {"type": "boolean"},
          "required_fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "affects": {"type": "string", "minLength": 1}
        }
      }
    },
    "rules": {"type": "object"}
  }
}
