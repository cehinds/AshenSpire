{
  "$schema": "agentops-mini-schema/v1",
  "title": "owner-command",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_version", "principle", "authenticated_actors", "actions", "rules"],
  "properties": {
    "schema": {"const": "agentops/owner-command/v1"},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "principle": {"type": "string", "minLength": 1},
    "authenticated_actors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "deputy"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "deputy": {"type": "string", "minLength": 1}
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "authenticator_roles", "requires_cas", "protected", "required_fields", "affects"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "authenticator_roles": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "requires_cas": {"type": "boolean"},
          "protected": {"type": "boolean"},
          "one_use": {"type": "boolean"},
          "expires": {"type": "boolean"},
          "structured_only": {"type": "boolean"},
          "consumes_on_attempt": {"type": "boolean"},
          "required_fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "affects": {"type": "string", "minLength": 1},
          "lifecycle_target": {"type": "string", "minLength": 1},
          "resolves_blocker": {"type": "boolean"}
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enumerated_only",
        "authenticated_actor",
        "owner_exclusive",
        "compare_and_swap",
        "no_arbitrary_input",
        "dry_run_first",
        "declared_lifecycle_target",
        "blocker_resolution",
        "append_only_apply",
        "reseat_is_not_a_sweep",
        "reseat_records_its_commander",
        "scheduler_migration_binding",
        "project_schema_change_binding",
        "scheduler_state_reconciliation_binding",
        "scheduler_cutover_binding",
        "protected_action_non_substitution",
        "protected_action_consumption"
      ],
      "properties": {
        "enumerated_only": {"type": "string", "minLength": 1},
        "authenticated_actor": {"type": "string", "minLength": 1},
        "owner_exclusive": {"type": "string", "minLength": 1},
        "compare_and_swap": {"type": "string", "minLength": 1},
        "no_arbitrary_input": {"type": "string", "minLength": 1},
        "dry_run_first": {"type": "string", "minLength": 1},
        "declared_lifecycle_target": {"type": "string", "minLength": 1},
        "blocker_resolution": {"type": "string", "minLength": 1},
        "append_only_apply": {"type": "string", "minLength": 1},
        "reseat_is_not_a_sweep": {"type": "string", "minLength": 1},
        "reseat_records_its_commander": {"type": "string", "minLength": 1},
        "scheduler_migration_binding": {"type": "string", "minLength": 1},
        "project_schema_change_binding": {"type": "string", "minLength": 1},
        "scheduler_state_reconciliation_binding": {"type": "string", "minLength": 1},
        "scheduler_cutover_binding": {"type": "string", "minLength": 1},
        "protected_action_non_substitution": {"type": "string", "minLength": 1},
        "protected_action_consumption": {"type": "string", "minLength": 1}
      }
    }
  }
}
