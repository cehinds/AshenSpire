{
  "$schema": "agentops-mini-schema/v1",
  "title": "promotion-gates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_version",
    "principle",
    "source",
    "immutable_candidate",
    "gates",
    "rules"
  ],
  "properties": {
    "schema": {
      "const": "agentops/promotion-gates/v1"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "principle": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "immutable_candidate": {
      "type": "string",
      "minLength": 1
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "actor_role",
          "entry",
          "required_evidence",
          "grants"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-F]$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "actor_role": {
            "type": "string",
            "minLength": 1
          },
          "entry": {
            "type": "string",
            "minLength": 1
          },
          "required_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_roles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "conditional_roles": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "when"
              ],
              "properties": {
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "when": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "grants": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "not_satisfied_by": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "explicitly_not_granted": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "blocks_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "invalidated_by": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "separate_actions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "authority_is_per_action": {
            "type": "boolean"
          },
          "on_fail_or_unknown": {
            "type": "string",
            "minLength": 1
          },
          "returns_to_gate_on_correction": {
            "type": "string",
            "pattern": "^[A-F]$"
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "guards_transitions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "to"
              ],
              "properties": {
                "from": {
                  "type": "string",
                  "minLength": 1
                },
                "to": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "rules": {
      "type": "object"
    }
  }
}
