{
  "$schema": "agentops-mini-schema/v1",
  "title": "migration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_version", "principle", "legacy_sources", "work_items", "rules"],
  "properties": {
    "schema": {"const": "agentops/migration/v1"},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "principle": {"type": "string", "minLength": 1},
    "legacy_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "kind", "classification", "disposition", "note"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "kind": {"enum": ["generated-view", "evidence", "authoritative-ledger", "reconstruction-bundle", "doc", "dashboard"]},
          "classification": {"enum": ["authoritative-current", "evidence", "generated-view", "superseded", "unknown"]},
          "disposition": {"enum": ["preserve-read-only", "reference-only", "migrate-to-capsule"]},
          "superseded_by": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "work_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "legacy_ref", "new_capsule", "status", "note"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "legacy_ref": {"type": ["string", "null"]},
          "new_capsule": {"type": "string", "minLength": 1},
          "status": {"enum": ["migrated", "proposed", "superseded", "unknown"]},
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "rules": {"type": "object"}
  }
}
