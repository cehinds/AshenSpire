{
  "$schema": "agentops-mini-schema/v1",
  "title": "owner-intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_version", "mission", "measurable_end_state", "priority_order", "risk_tolerance", "non_negotiable_invariants", "default_autonomy", "owner", "deputy", "protected_decision_classes", "override_rules"],
  "properties": {
    "schema": {"const": "agentops/owner-intent/v1"},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "mission": {"type": "string", "minLength": 1},
    "measurable_end_state": {"type": "string", "minLength": 1},
    "priority_order": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "risk_tolerance": {"enum": ["LOW", "STANDARD", "HIGH"]},
    "non_negotiable_invariants": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "default_autonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reversible_local_work", "description"],
      "properties": {
        "reversible_local_work": {"enum": ["PROCEED", "GATED"]},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "display_name", "identifiers", "reserved_authority"],
      "properties": {
        "actor_id": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "identifiers": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "reserved_authority": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
      }
    },
    "deputy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "role", "display_name", "grant_summary", "included_actions", "excluded_actions", "effective", "expiry", "supersession", "non_amplifying_rule"],
      "properties": {
        "actor_id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "former_name": {"type": "string"},
        "grant_summary": {"type": "string", "minLength": 1},
        "included_actions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "excluded_actions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "effective": {"type": "string", "minLength": 1},
        "expiry": {"type": "string", "minLength": 1},
        "supersession": {"type": "string", "minLength": 1},
        "non_amplifying_rule": {"type": "string", "minLength": 1}
      }
    },
    "protected_decision_classes": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "override_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recording", "invalidation", "forbidden"],
      "properties": {
        "recording": {"type": "string", "minLength": 1},
        "invalidation": {"type": "string", "minLength": 1},
        "forbidden": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
      }
    }
  }
}
