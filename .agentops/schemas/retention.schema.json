{
  "$schema": "agentops-mini-schema/v1",
  "title": "retention",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_version",
    "principle",
    "authority",
    "consolidation",
    "never",
    "corrections_are_never_consolidated",
    "rules"
  ],
  "properties": {
    "schema": {
      "const": "agentops/retention/v1"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "principle": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "actor_role",
        "is_a_new_grant",
        "preconditions"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "actor_role": {
          "type": "string",
          "minLength": 1
        },
        "is_a_new_grant": {
          "type": "boolean"
        },
        "preconditions": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "consolidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "appends_only",
        "min_range",
        "summary_must_name",
        "rule"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "appends_only": {
          "const": true
        },
        "min_range": {
          "type": "number"
        },
        "summary_must_name": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "never": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "corrections_are_never_consolidated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "protected_tickets"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "protected_tickets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rules": {
      "type": "object"
    }
  }
}
