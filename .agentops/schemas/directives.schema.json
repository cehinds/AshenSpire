{
  "$schema": "agentops-mini-schema/v1",
  "title": "directives",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_version",
    "principle",
    "non_amplification",
    "directives",
    "rules"
  ],
  "properties": {
    "schema": {
      "const": "agentops/directives/v1"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "principle": {
      "type": "string",
      "minLength": 1
    },
    "non_amplification": {
      "type": "string",
      "minLength": 1
    },
    "directives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "issued_by",
          "issued_at",
          "source",
          "text",
          "status",
          "grants_actions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "issued_by": {
            "type": "string",
            "minLength": 1
          },
          "issued_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "standing",
              "superseded"
            ]
          },
          "codified_in": {
            "type": "string",
            "minLength": 1
          },
          "codified_as": {
            "type": "string",
            "minLength": 1
          },
          "superseded_by": {
            "type": "string",
            "minLength": 1
          },
          "grants_actions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "rules": {
      "type": "object"
    }
  }
}
