{
  "$schema": "agentops-mini-schema/v1",
  "title": "git-ownership",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_version", "principle", "refs", "paths", "generated_serialization", "collision_rule"],
  "properties": {
    "schema": {"const": "agentops/git-ownership/v1"},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "principle": {"type": "string", "minLength": 1},
    "refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "owner_role", "mutation"],
        "properties": {
          "ref": {"type": "string", "minLength": 1},
          "owner_role": {"type": "string", "minLength": 1},
          "mutation": {"type": "string", "minLength": 1},
          "per_seat": {"type": "boolean"},
          "note": {"type": "string"}
        }
      }
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["glob", "owner_role", "serialized_lane"],
        "properties": {
          "glob": {"type": "string", "minLength": 1},
          "owner_role": {"type": "string", "minLength": 1},
          "serialized_lane": {"type": "string", "minLength": 1},
          "note": {"type": "string"}
        }
      }
    },
    "generated_serialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "rule"],
      "properties": {
        "lane": {"type": "string", "minLength": 1},
        "rule": {"type": "string", "minLength": 1}
      }
    },
    "collision_rule": {"type": "string", "minLength": 1}
  }
}
