{
  "$schema": "agentops-mini-schema/v1",
  "title": "escalation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_version",
    "principle",
    "default_sla_minutes",
    "classes",
    "rules",
    "ticket_flow"
  ],
  "properties": {
    "schema": {
      "const": "agentops/escalation/v1"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "principle": {
      "type": "string",
      "minLength": 1
    },
    "default_sla_minutes": {
      "type": "integer"
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "hazard",
          "attempts_before_escalate",
          "sla_minutes",
          "route",
          "wake",
          "authority_effect",
          "continuing_work_allowed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "hazard": {
            "type": "string",
            "minLength": 1
          },
          "attempts_before_escalate": {
            "type": "integer"
          },
          "sla_minutes": {
            "type": "integer"
          },
          "route": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "wake": {
            "type": "string",
            "minLength": 1
          },
          "authority_effect": {
            "const": "request-decision"
          },
          "continuing_work_allowed": {
            "type": "boolean"
          }
        }
      }
    },
    "rules": {
      "type": "object"
    },
    "ticket_flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principle",
        "source",
        "steps",
        "handoff_events",
        "handoff_rule",
        "owner_is_last_resort"
      ],
      "properties": {
        "principle": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "n",
              "actor",
              "does"
            ],
            "properties": {
              "n": {
                "type": "number"
              },
              "actor": {
                "type": "string",
                "minLength": 1
              },
              "does": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "handoff_events": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "handoff_rule": {
          "type": "string",
          "minLength": 1
        },
        "owner_is_last_resort": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
