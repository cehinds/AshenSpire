{
  "$schema": "agentops-mini-schema/v1",
  "title": "escalation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_version", "principle", "default_sla_minutes", "classes", "rules"],
  "properties": {
    "schema": {"const": "agentops/escalation/v1"},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "principle": {"type": "string", "minLength": 1},
    "default_sla_minutes": {"type": "integer"},
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "hazard", "attempts_before_escalate", "sla_minutes", "route", "wake", "authority_effect", "continuing_work_allowed"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "hazard": {"type": "string", "minLength": 1},
          "attempts_before_escalate": {"type": "integer"},
          "sla_minutes": {"type": "integer"},
          "route": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "wake": {"type": "string", "minLength": 1},
          "authority_effect": {"const": "request-decision"},
          "continuing_work_allowed": {"type": "boolean"}
        }
      }
    },
    "rules": {"type": "object"}
  }
}
