{
  "$schema": "agentops-mini-schema/v1",
  "title": "information-access",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_version",
    "principle",
    "max_startup_items",
    "startup_token_target",
    "startup_token_hard_limit",
    "startup",
    "on_demand",
    "restricted",
    "forbidden",
    "reporting",
    "rules",
    "canonical_documents"
  ],
  "properties": {
    "schema": {
      "const": "agentops/information-access/v1"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "principle": {
      "type": "string",
      "minLength": 1
    },
    "max_startup_items": {
      "type": "integer"
    },
    "startup_token_target": {
      "type": "integer"
    },
    "startup_token_hard_limit": {
      "type": "integer"
    },
    "startup": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "on_demand": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "restricted": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "forbidden": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "must",
        "must_not",
        "owner_decision_exception",
        "decision_packet"
      ],
      "properties": {
        "style": {
          "type": "string",
          "minLength": 1
        },
        "owner_decision_exception": {
          "type": "string",
          "minLength": 1
        },
        "decision_packet": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "parts",
            "open_question_is_a_failure"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "parts": {
              "type": "array",
              "minItems": 5,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "open_question_is_a_failure": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "must": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "must_not": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "rules": {
      "type": "object"
    },
    "canonical_documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "path",
          "superseded_paths",
          "decision"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "superseded_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "decision": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
