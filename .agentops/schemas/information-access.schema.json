{
  "$schema": "agentops-mini-schema/v1",
  "title": "information-access",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_version", "principle", "max_startup_items", "startup_token_target", "startup_token_hard_limit", "startup", "on_demand", "restricted", "forbidden", "rules"],
  "properties": {
    "schema": {"const": "agentops/information-access/v1"},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "principle": {"type": "string", "minLength": 1},
    "max_startup_items": {"type": "integer"},
    "startup_token_target": {"type": "integer"},
    "startup_token_hard_limit": {"type": "integer"},
    "startup": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "on_demand": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "restricted": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "forbidden": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "rules": {"type": "object"}
  }
}
