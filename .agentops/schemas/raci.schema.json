{
  "$schema": "agentops-mini-schema/v1",
  "title": "raci",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_version", "principle", "items", "rules"],
  "properties": {
    "schema": {"const": "agentops/raci/v1"},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "principle": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "responsible", "accountable", "consulted", "informed"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["deliverable", "decision"]},
          "responsible": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "accountable": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "consulted": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "informed": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "rules": {"type": "object"}
  }
}
