{
  "$schema": "agentops-mini-schema/v1",
  "title": "qa",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_version", "principle", "risk_classes", "gates", "self_certification", "rules"],
  "properties": {
    "schema": {"const": "agentops/qa/v1"},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "principle": {"type": "string", "minLength": 1},
    "risk_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "required_suites", "independent_qa"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "required_suites": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "independent_qa": {"type": "boolean"}
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "risk_class", "required_checks", "required_evidence", "verifier_role", "independent_of_maker", "waiver_authority_role"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "risk_class": {"type": "string", "minLength": 1},
          "required_checks": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "required_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "verifier_role": {"type": "string", "minLength": 1},
          "independent_of_maker": {"type": "boolean"},
          "waiver_authority_role": {"type": "string", "minLength": 1}
        }
      }
    },
    "self_certification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principle",
        "permitted_risk_classes",
        "high_risk_is_excluded_because",
        "approver_role",
        "approver_must_lead_the_certifying_seats_team",
        "approver_must_differ_from_the_certifying_seat",
        "standing_authority_from",
        "delegation_envelope",
        "verdict_kind",
        "records",
        "never"
      ],
      "properties": {
        "principle": {"type": "string", "minLength": 1},
        "permitted_risk_classes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "high_risk_is_excluded_because": {"type": "string", "minLength": 1},
        "approver_role": {"type": "string", "minLength": 1},
        "approver_must_lead_the_certifying_seats_team": {"const": true},
        "approver_must_differ_from_the_certifying_seat": {"const": true},
        "standing_authority_from": {"type": "string", "minLength": 1},
        "delegation_envelope": {"type": "string", "minLength": 1},
        "verdict_kind": {"type": "string", "minLength": 1},
        "records": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "never": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "rules": {"type": "object"}
  }
}
