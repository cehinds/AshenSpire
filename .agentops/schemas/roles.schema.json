{
  "$schema": "agentops-mini-schema/v1",
  "title": "roles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_version", "roles"],
  "properties": {
    "schema": {"const": "agentops/roles/v1"},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "mission", "may", "must", "must_not", "approval_ceiling"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "mission": {"type": "string", "minLength": 1},
          "may": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "must": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "must_not": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "approval_ceiling": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
