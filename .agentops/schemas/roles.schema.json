{
  "$schema": "agentops-mini-schema/v1",
  "title": "roles",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_version",
    "roles",
    "non_seat_writers",
    "non_seat_writers_are_not_roles"
  ],
  "properties": {
    "schema": {
      "const": "agentops/roles/v1"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "non_seat_writers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "appears_in",
          "means"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "appears_in": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "means": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "non_seat_writers_are_not_roles": {
      "type": "string",
      "minLength": 1
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "mission",
          "may",
          "must",
          "must_not",
          "approval_ceiling"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "mission": {
            "type": "string",
            "minLength": 1
          },
          "archetype": {
            "type": "string",
            "minLength": 1
          },
          "may": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "must": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "must_not": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "approval_ceiling": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
