{
  "$schema": "agentops-mini-schema/v1",
  "title": "model-effort",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_version", "principle", "source", "assignment_record", "tiers", "substitution", "stability", "grants", "rules"],
  "properties": {
    "schema": {"const": "agentops/model-effort/v1"},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "principle": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "assignment_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "required_fields", "recorded_on"],
      "properties": {
        "format": {"type": "string", "minLength": 1},
        "required_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "recorded_on": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "risk_and_station", "default_model", "allowed_efforts", "typical_work"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "risk_and_station": {"type": "string", "minLength": 1},
          "default_model": {"type": "string", "minLength": 1},
          "allowed_efforts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "requires_exceptional_reason": {"type": "boolean"},
          "typical_work": {"type": "string", "minLength": 1}
        }
      }
    },
    "substitution": {"type": "string", "minLength": 1},
    "stability": {"type": "string", "minLength": 1},
    "grants": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "rules": {"type": "object"}
  }
}
