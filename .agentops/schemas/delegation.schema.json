{
  "$schema": "agentops-mini-schema/v1",
  "title": "delegation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_version", "non_amplification_rule", "envelopes", "rules"],
  "properties": {
    "schema": {"const": "agentops/delegation/v1"},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "non_amplification_rule": {"type": "string", "minLength": 1},
    "envelopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "parent_id", "delegator_role", "delegatee_role", "delegated_actions", "scope_paths", "max_subdelegation_depth", "effective", "expiry"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "parent_id": {"type": ["string", "null"]},
          "delegator_role": {"type": "string", "minLength": 1},
          "delegatee_role": {"type": "string", "minLength": 1},
          "delegated_actions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "scope_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "max_subdelegation_depth": {"type": "integer"},
          "effective": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
          "expiry": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
        }
      }
    },
    "rules": {"type": "object"}
  }
}
