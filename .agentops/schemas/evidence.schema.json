{
  "$schema": "agentops-mini-schema/v1",
  "title": "evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_version", "principle", "evidence", "rules"],
  "properties": {
    "schema": {"const": "agentops/evidence/v1"},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "principle": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "producer_role", "exact_object", "verifier_role", "freshness_rule", "invalidation_keys"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "producer_role": {"type": "string", "minLength": 1},
          "exact_object": {"type": "string", "minLength": 1},
          "verifier_role": {"type": "string", "minLength": 1},
          "freshness_rule": {"type": "string", "minLength": 1},
          "invalidation_keys": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
        }
      }
    },
    "rules": {"type": "object"}
  }
}
