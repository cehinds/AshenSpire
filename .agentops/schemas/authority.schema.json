{
  "$schema": "agentops-mini-schema/v1",
  "title": "authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_version",
    "grants",
    "evidence_expected_is_prose"
  ],
  "properties": {
    "schema": {
      "const": "agentops/authority/v1"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "note": {
      "type": "string"
    },
    "grants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "routine_owner_role",
          "scope",
          "evidence_expected"
        ],
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1
          },
          "routine_owner_role": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "evidence_expected": {
            "type": "string",
            "minLength": 1
          },
          "protected": {
            "type": "boolean"
          }
        }
      }
    },
    "evidence_expected_is_prose": {
      "type": "string",
      "minLength": 1
    }
  }
}
