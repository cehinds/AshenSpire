{
  "schema": "agentops/raci/v1",
  "policy_version": "1.0.0",
  "principle": "Exactly one Accountable per deliverable or decision. Responsible executes; Accountable owns the outcome and the go/no-go; Consulted give bounded input; Informed receive the result. Accountable is never the sole Responsible for its own independent-QA acceptance.",
  "items": [
    {
      "id": "feature-implementation",
      "kind": "deliverable",
      "responsible": ["maker"],
      "accountable": ["it-manager-iii"],
      "consulted": ["data-architecture-lead"],
      "informed": ["help-desk", "project-management-lead"]
    },
    {
      "id": "independent-qa-acceptance",
      "kind": "decision",
      "responsible": ["qa-independent"],
      "accountable": ["qa-independent"],
      "consulted": ["it-manager-iii"],
      "informed": ["help-desk", "project-management-lead"]
    },
    {
      "id": "dev-integration",
      "kind": "decision",
      "responsible": ["it-manager-iii"],
      "accountable": ["it-manager-iii"],
      "consulted": ["data-architecture-lead", "qa-independent"],
      "informed": ["help-desk", "project-management-lead"]
    },
    {
      "id": "data-contract-review",
      "kind": "decision",
      "responsible": ["data-architecture-lead"],
      "accountable": ["data-architecture-lead"],
      "consulted": ["it-manager-iii"],
      "informed": ["help-desk"]
    },
    {
      "id": "portfolio-sequencing",
      "kind": "decision",
      "responsible": ["project-management-lead"],
      "accountable": ["it-manager-iii"],
      "consulted": ["project-management-lead", "data-architecture-lead"],
      "informed": ["help-desk"]
    },
    {
      "id": "release-and-publication",
      "kind": "decision",
      "responsible": ["owner"],
      "accountable": ["owner"],
      "consulted": ["it-manager-iii", "qa-independent"],
      "informed": ["project-management-lead", "help-desk"]
    }
  ],
  "rules": {
    "single_accountable": "Each item lists exactly one Accountable role.",
    "no_maker_self_acceptance": "The Accountable for an independent-QA acceptance decision must not also be the Responsible maker of the object under review."
  }
}
