{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentops/scheduler-state-reconciliation-attempt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "attempt_id", "status", "authority", "reconciler", "source", "target", "quiet_window_receipt_hash", "trusted_now", "state_ref", "development_ref", "invariants"],
  "properties": {
    "schema": {"const": "agentops/scheduler-state-reconciliation-attempt/v1"},
    "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["ATTEMPTED", "AMBIGUOUS_UNCHANGED_CONSUMED"]},
    "authority": {"type": "object", "additionalProperties": false, "required": ["authority_state_oid", "event_path", "event_id", "event_hash"], "properties": {
      "authority_state_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "event_path": {"type": "string", "pattern": "^\\.agentops/events/[^/]+/[^/]+\\.json$"}, "event_id": {"type": "string", "minLength": 1}, "event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }},
    "reconciler": {"type": "object", "additionalProperties": false, "required": ["head", "tree"], "properties": {"head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["state_oid", "state_tree", "snapshot_sha256", "journal_manifest_sha256", "event_count", "state_version"], "properties": {
      "state_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "state_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "journal_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "event_count": {"type": "integer", "minimum": 0}, "state_version": {"type": "integer", "minimum": 1}
    }},
    "target": {"type": "object", "additionalProperties": false, "required": ["state_oid", "state_tree", "snapshot_sha256", "journal_manifest_sha256", "event_count"], "properties": {
      "state_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "state_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "journal_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "event_count": {"type": "integer", "minimum": 0}
    }},
    "quiet_window_receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "trusted_now": {"type": "string", "format": "date-time"},
    "state_ref": {"const": "refs/heads/agentops/scheduler-state"}, "development_ref": {"const": "refs/heads/dev"},
    "invariants": {"type": "object", "additionalProperties": false, "required": ["dispatch_frozen", "no_refill", "no_assignment", "no_dispatch", "no_external_mutation", "push_mode", "abort_on_remote_change"], "properties": {
      "dispatch_frozen": {"const": true}, "no_refill": {"const": true}, "no_assignment": {"const": true}, "no_dispatch": {"const": true}, "no_external_mutation": {"const": true}, "push_mode": {"const": "non-force-forward-only-cas"}, "abort_on_remote_change": {"const": true}
    }}
  }
}
