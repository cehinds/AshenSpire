{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentops/scheduler-wake/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["IDENTITY", "ISSUE", "OBJECTIVE", "FIRST_ACTION", "DONE_WHEN", "REPOSITORY", "BASE_COMMIT", "BRANCH_WORKTREE", "ALLOWED_PATHS", "CLAIMED_RESOURCES", "LEASE", "ACCEPTANCE_COMMANDS", "EVIDENCE_TARGET", "AUTHORITY_CEILING", "FORBIDDEN_ACTIONS", "BLOCKER_WAKE", "ROLLBACK"],
  "properties": {
    "IDENTITY": { "type": "string" },
    "ISSUE": { "type": "string" },
    "OBJECTIVE": { "type": "string" },
    "FIRST_ACTION": { "type": "string" },
    "DONE_WHEN": { "type": "string" },
    "REPOSITORY": { "type": "string" },
    "BASE_COMMIT": { "type": ["string", "null"] },
    "BRANCH_WORKTREE": { "type": ["string", "null"] },
    "ALLOWED_PATHS": { "type": "array", "items": { "type": "string" } },
    "CLAIMED_RESOURCES": { "type": "array", "items": { "type": "string" } },
    "LEASE": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "epoch", "expiry"],
      "properties": {
        "id": { "type": "string" },
        "epoch": { "type": "integer", "minimum": 1 },
        "expiry": { "type": "string", "format": "date-time" }
      }
    },
    "ACCEPTANCE_COMMANDS": { "type": "array", "items": { "type": "string" } },
    "EVIDENCE_TARGET": { "type": "array", "items": { "type": "string" } },
    "AUTHORITY_CEILING": { "type": "string" },
    "FORBIDDEN_ACTIONS": { "type": "array", "items": { "type": "string" } },
    "BLOCKER_WAKE": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocker", "wake_condition"],
      "properties": {
        "blocker": { "type": ["string", "null"] },
        "wake_condition": { "type": ["string", "null"] }
      }
    },
    "ROLLBACK": { "type": "string" }
  }
}
