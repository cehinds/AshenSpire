{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentops/scheduler-event/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "idempotency_key", "sequence", "previous_snapshot_hash", "issue_id", "actor", "machine_id", "lease_id", "lease_epoch", "event_type", "exact_object", "payload", "created_at"],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "previous_snapshot_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "issue_id": { "type": "string", "minLength": 1 },
    "actor": { "type": "string", "minLength": 1 },
    "machine_id": { "type": ["string", "null"] },
    "lease_id": { "type": ["string", "null"] },
    "lease_epoch": { "type": ["integer", "null"], "minimum": 1 },
    "event_type": { "enum": ["INTAKE_RECORDED", "CLAIM_ACQUIRED", "WORK_ENTERED", "CANDIDATE_READY", "QA_RESULT", "PR_OPENED", "MERGED_DEV", "BLOCKED", "RESOURCE_RELEASED", "LEASE_EXPIRED", "DRIFT_DETECTED", "RECOVERY_BOUND", "SUPERSEDED", "CANCELLED", "COMPLETED"] },
    "exact_object": { "type": "object" },
    "payload": { "type": "object" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
