{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentops/scheduler-snapshot/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "last_sequence", "work_items", "errors", "migration", "snapshot_hash"],
  "properties": {
    "schema": { "const": "agentops/scheduler-snapshot/v2" },
    "revision": { "type": "integer", "minimum": 0 },
    "last_sequence": { "type": "integer", "minimum": 0 },
    "work_items": { "type": "object" },
    "errors": { "type": "array" },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary_event_id", "source_state_oid", "source_state_tree", "source_snapshot_hash", "legacy_journal_manifest_hash", "legacy_machine_lease", "preserved_local_tip", "dispatch_frozen", "quarantine_count", "alias_projection_hash"],
      "properties": {
        "boundary_event_id": { "type": "string", "minLength": 1 },
        "source_state_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "source_state_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "source_snapshot_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "legacy_journal_manifest_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "legacy_machine_lease": { "type": ["object", "null"] },
        "preserved_local_tip": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "dispatch_frozen": { "const": true },
        "quarantine_count": { "type": "integer", "minimum": 0 },
        "alias_projection_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "snapshot_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
