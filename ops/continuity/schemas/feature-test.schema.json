{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ashenspire.feature.test.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ticketId", "channel", "ref", "revision", "immutable", "commit", "originObservedCommit", "observedAtUtc", "currentness", "promotedFromDevRevision", "promotedFromDevCommit", "qa", "guard"],
  "properties": {
    "schemaVersion": { "const": "ashenspire.feature.test.v1" },
    "ticketId": { "type": "string", "minLength": 1 },
    "channel": { "const": "TEST" },
    "ref": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "immutable": { "const": true },
    "commit": { "$ref": "#/$defs/commit" },
    "originObservedCommit": { "$ref": "#/$defs/commit" },
    "observedAtUtc": { "type": ["string", "null"], "format": "date-time" },
    "currentness": { "enum": ["ORIGIN_REF_ABSENT", "CURRENT", "STALE"] },
    "promotedFromDevRevision": { "type": ["integer", "null"], "minimum": 1 },
    "promotedFromDevCommit": { "$ref": "#/$defs/commit" },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "testRevision", "commit", "atUtc", "evidence"],
      "properties": {
        "status": { "enum": ["NOT_RUN", "PASS", "FAIL"] },
        "testRevision": { "type": ["integer", "null"], "minimum": 1 },
        "commit": { "$ref": "#/$defs/commit" },
        "atUtc": { "type": ["string", "null"], "format": "date-time" },
        "evidence": { "type": ["string", "null"] }
      }
    },
    "guard": { "$ref": "#/$defs/guardOrNull" }
  },
  "$defs": {
    "commit": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
    "guardOrNull": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "blocks", "retryTrigger", "safeWork"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "blocks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "retryTrigger": { "type": "string", "minLength": 1 },
            "safeWork": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    }
  }
}
