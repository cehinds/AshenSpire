{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ashenspire.continuity.ticket.v1",
  "title": "AshenSpire continuity ticket",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "priority", "status", "teamId", "owner", "scope", "migrationBoundary", "historyIds"],
  "properties": {
    "schemaVersion": { "const": "ashenspire.continuity.ticket.v1" },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "priority": { "enum": ["T0", "T1", "T2", "T3", "T4"] },
    "status": { "type": "string", "minLength": 1 },
    "teamId": { "type": "string", "minLength": 1 },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "taskId"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "taskId": { "type": "string", "minLength": 1 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedRoots", "forbiddenActions"],
      "properties": {
        "allowedRoots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "forbiddenActions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "migrationBoundary": { "type": "string", "minLength": 1 },
    "historyIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
