{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ashenspire.continuity.team.v2",
  "title": "AshenSpire continuity team v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "owner", "writerPolicy", "activeTickets"],
  "properties": {
    "schemaVersion": { "const": "ashenspire.continuity.team.v2" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "owner": { "$ref": "#/$defs/owner" },
    "writerPolicy": { "const": "ONE_WRITER_PER_PATH" },
    "activeTickets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/fileRef" },
          {
            "type": "object",
            "required": ["id"],
            "properties": { "id": { "type": "string", "minLength": 1 } }
          }
        ]
      }
    }
  },
  "$defs": {
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "taskId"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "taskId": { "type": "string", "minLength": 1 }
      }
    },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
      }
    }
  }
}
