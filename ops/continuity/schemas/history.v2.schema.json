{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ashenspire.continuity.history.v2",
  "title": "AshenSpire continuity history event v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "sequence", "recordedAtUtc", "teamId", "ticketId", "event", "supersedesHistoryId", "lifecycle", "evidence"],
  "properties": {
    "schemaVersion": { "const": "ashenspire.continuity.history.v2" },
    "id": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "recordedAtUtc": { "type": "string", "format": "date-time" },
    "teamId": { "type": "string", "minLength": 1 },
    "ticketId": { "type": "string", "minLength": 1 },
    "event": { "type": "string", "minLength": 1 },
    "supersedesHistoryId": { "type": ["string", "null"] },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "legacyFrom"],
      "properties": {
        "from": { "type": ["string", "null"] },
        "to": { "type": "string", "minLength": 1 },
        "legacyFrom": { "type": ["string", "null"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
      }
    }
  }
}
