root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,mjs,cjs}]
indent_size = 4
end_of_line = lf

[*.json]
indent_size = 2
end_of_line = lf

[*.css]
end_of_line = lf

[engine/kernel/**]
indent_size = 2
end_of_line = lf

[engine/runtime/**]
indent_size = 2
end_of_line = lf

[src/model/formulas.js]
indent_size = 2
end_of_line = lf

[src/model/fixCoreMechanics.js]
indent_size = 2
end_of_line = lf

[*.md]
trim_trailing_whitespace = false
