{
  "$note": "Touch flick gesture cases for tests/card-removal-flick.test.mjs. A distanceRule names a touchFlick.distance rule (min, max or def) so the case follows config.",
  "referenceSettings": {
    "$note": "Gesture points below are drawn for a 64 px threshold, so the shipped default can change freely.",
    "touchFlickDistance": 64
  },
  "start": { "x": 90, "y": 700, "time": 0 },
  "end": { "x": 100, "y": 630, "time": 100 },
  "verdictCases": [
    {
      "label": "a short intentional upward flick qualifies",
      "expected": true
    },
    {
      "label": "disabled stays disabled",
      "settings": { "touchFlickPlay": false },
      "expected": false
    },
    {
      "label": "live distance changes recognition",
      "distanceRule": "max",
      "expected": false
    },
    {
      "label": "minimum configured distance is usable",
      "release": { "x": 90, "y": 668, "time": 80 },
      "distanceRule": "min",
      "expected": true
    },
    {
      "label": "small tap movement is not play",
      "release": { "x": 90, "y": 690, "time": 100 },
      "expected": false
    },
    {
      "label": "downward release is not play",
      "release": { "x": 90, "y": 730, "time": 100 },
      "expected": false
    },
    {
      "label": "sideways hand movement is not play",
      "release": { "x": 180, "y": 630, "time": 100 },
      "expected": false
    },
    {
      "label": "pausing above threshold is not a flick",
      "release": { "x": 100, "y": 630, "time": 500 },
      "expected": false
    },
    {
      "label": "reversing toward hand cancels",
      "release": { "x": 90, "y": 645, "time": 110 },
      "expected": false
    }
  ],
  "preferenceCases": [
    {
      "label": "invalid settings fall back",
      "settings": { "touchFlickDistance": "not a number" },
      "expectedDistanceRule": "def"
    },
    {
      "label": "settings clamp to the upper bound",
      "settings": { "touchFlickDistance": 999 },
      "expectedDistanceRule": "max"
    }
  ],
  "targetCases": [
    {
      "label": "equidistant targets have a stable tie-break",
      "targets": [
        { "id": "b", "x": 0, "y": 0 },
        { "id": "a", "x": 2, "y": 0 }
      ],
      "point": { "x": 1, "y": 0 },
      "expectedId": "a"
    },
    {
      "label": "no legal target returns none",
      "targets": [],
      "point": { "x": 100, "y": 630, "time": 100 },
      "expectedId": null
    }
  ]
}
